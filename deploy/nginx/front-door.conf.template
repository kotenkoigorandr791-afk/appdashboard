map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
upstream appdashboard_backend {
    server __APP_UPSTREAM__;
    keepalive 32;
}
server {
    listen 80;
    listen [::]:80;
    server_name git.__BASE_DOMAIN__;
    include /opt/docker/appdashboard/nginx/cloudflare-realip.conf;
    client_max_body_size 1024m;
    location / {
        proxy_pass __GITEA_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host __GITEA_PROXY_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "frame-ancestors 'self' __APP_PUBLIC_URL__" always;
    }
}
