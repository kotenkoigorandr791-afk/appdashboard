server {
    listen 80;
    listen [::]:80;
    server_name __AI_HOST__;
    include /opt/docker/appdashboard/nginx/cloudflare-realip.conf;
    client_max_body_size 64m;
    access_log /var/log/nginx/omniroute_access.log;
    error_log /var/log/nginx/omniroute_error.log warn;
    location / {
        proxy_pass __OMNIROUTE_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}

