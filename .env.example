# Copy to .env and adjust. Only BASE_DOMAIN is required for public URLs.

BASE_DOMAIN=localhost
APP_PUBLIC_SCHEME=http

# Optional overrides (defaults are derived from BASE_DOMAIN):
# APP_PUBLIC_BASE_URL=http://localhost
# AI_PUBLIC_HOST=ai.localhost
# AI_PUBLIC_URL=http://ai.localhost
# OmniRoute Next.js on host :20128 (WS tunnel for /admin-omniroute). Compose default: host.docker.internal:20128
# OMNIROUTE_UPSTREAM=http://host.docker.internal:20128
# SEARCH_PUBLIC_URL=http://search.localhost
# GITEA_PUBLIC_URL=http://git.localhost
# IMMICH_PUBLIC_URL=http://photo.localhost
# DOCUMENT_PUBLIC_URL=http://document.localhost
# DOCKER_PUBLIC_URL=http://docker.localhost
# DAWARICH_PUBLIC_URL=http://dawarich.localhost

DB_PASSWORD=appdashboard_dev_password
APP_ENV=local
APP_DEBUG=1
APP_WAF_RULE_ENGINE=On

# SSH Terminal default target (auto-seeded on first boot if no profile saved)
SSH_DEFAULT_HOST=host.docker.internal
SSH_DEFAULT_USER=root
SSH_DEFAULT_PORT=22
