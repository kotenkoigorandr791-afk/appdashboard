\n\t\t\t\t\tif ( scope.screenSpacePanning === true ) {\r\n\r\n\t\t\t\t\t\tv.setFromMatrixColumn( objectMatrix, 1 );\r\n\r\n\t\t\t\t\t} else {\r\n\r\n\t\t\t\t\t\tv.setFromMatrixColumn( objectMatrix, 0 );\r\n\t\t\t\t\t\tv.crossVectors( scope.object.up, v );\r\n\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t\tv.multiplyScalar( distance );\r\n\t\t\t\t\tpanOffset.add( v );\r\n\r\n\t\t\t\t};\r\n\r\n\t\t\t}", "is_member_call": false, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L342"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "setFromMatrixColumn", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L349"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "setFromMatrixColumn", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L353"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "crossVectors", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L354"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "multiplyScalar", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L358"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "add", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L359"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "function () {\r\n\r\n\t\t\t\tconst offset = new THREE.Vector3();\r\n\t\t\t\treturn function pan( deltaX, deltaY ) {\r\n\r\n\t\t\t\t\tconst element = scope.domElement;\r\n\r\n\t\t\t\t\tif ( scope.object.isPerspectiveCamera ) {\r\n\r\n\t\t\t\t\t\t// perspective\r\n\t\t\t\t\t\tconst position = scope.object.position;\r\n\t\t\t\t\t\toffset.copy( position ).sub( scope.target );\r\n\t\t\t\t\t\tlet targetDistance = offset.length(); // half of the fov is center to top of screen\r\n\r\n\t\t\t\t\t\ttargetDistance *= Math.tan( scope.object.fov / 2 * Math.PI / 180.0 ); // we use only clientHeight here so aspect ratio does not distort speed\r\n\r\n\t\t\t\t\t\tpanLeft( 2 * deltaX * targetDistance / element.clientHeight, scope.object.matrix );\r\n\t\t\t\t\t\tpanUp( 2 * deltaY * targetDistance / element.clientHeight, scope.object.matrix );\r\n\r\n\t\t\t\t\t} else if ( scope.object.isOrthographicCamera ) {\r\n\r\n\t\t\t\t\t\t// orthographic\r\n\t\t\t\t\t\tpanLeft( deltaX * ( scope.object.right - scope.object.left ) / scope.object.zoom / element.clientWidth, scope.object.matrix );\r\n\t\t\t\t\t\tpanUp( deltaY * ( scope.object.top - scope.object.bottom ) / scope.object.zoom / element.clientHeight, scope.object.matrix );\r\n\r\n\t\t\t\t\t} else {\r\n\r\n\t\t\t\t\t\t// camera neither orthographic nor perspective\r\n\t\t\t\t\t\tconsole.warn( 'WARNING: OrbitControls.js encountered an unknown camera type - pan disabled.' );\r\n\t\t\t\t\t\tscope.enablePan = false;\r\n\r\n\t\t\t\t\t}\r\n\r\n\t\t\t\t};\r\n\r\n\t\t\t}", "is_member_call": false, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L366"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "sub", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L377"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "copy", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L377"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "length", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L378"}, {"caller_nid": "js_orbitcontrols_orbitcontrols_constructor", "callee": "tan", "is_member_call": true, "source_file": "/mnt/server/apps/cloud/js/OrbitControls.js", "source_location": "L380"}, {"caller_nid": "js