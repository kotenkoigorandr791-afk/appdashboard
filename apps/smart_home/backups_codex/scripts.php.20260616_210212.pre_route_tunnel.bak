  candidates.sort((a, b) => Math.hypot(a.x - center.x, a.y - center.y) - Math.hypot(b.x - center.x, b.y - center.y));
  for (const c of candidates) {
    const box = fpLabelBoxAt(ctx, c.x, c.y, text, fontSize);
    if (!fpLabelFitsElement(el, box, 4)) continue;
    if (occupied.some(ob => fpRectOverlap(box, ob, 4))) continue;
    if (blockers.some(ob => fpRectOverlap(box, ob, 4))) continue;
    return { x: c.x, y: c.y, box, ok: true };
  }
  return { ok: false };
}
function fpCollectLabelBlockers(sourceEl, type) {
  return (FP.elements || []).filter(el => el !== sourceEl).map(el => {
    if (type === 'room' && (el.type === 'furniture' || el.type === 'device' || el.type === 'room-label')) return fpBoundsOfElement(el);
    if (type === 'furniture' && (el.type === 'device' || el.type === 'room-label')) return fpBoundsOfElement(el);
    return null;
  }).filter(Boolean);
}
function fpDrawPolyPath(ctx, pts, close) {
  if (!pts?.length) return;
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].x, pts[i].y);
  if (close) ctx.closePath();
}
function fpIsPolyTool(t) { return t === 'room-poly' || t === 'furniture-poly'; }
function fpFinishPolygon() {
  const pts = FP.polyPoints;
  if (!pts || pts.length < 3) return;
  const furn = FP.tool === 'furniture-poly';
  const el = { type: furn ? 'furniture' : 'room', shape: 'poly', points: pts.map(p => ({ x: p.x, y: p.y })), scale: 1 };
  if (furn) el.label = 'table';
  else { el.text = 'Room'; el.floorType = 'wood'; }
  FP.polyPoints = null;
  const i = FP.elements.length;
  FP.elements.push(el);
  fpPushHistory();
  fpSelectEl(i);
  fpSave();
}
function fpSetTool(tool) {
  if (fpIsViewOnly()) return;
  FP.tool = tool;
  FP.drawing = false;
  FP.polyPoints = null;
  FP.vertexDrag = -1;
  FP.devMode = false;
  FP.devId = null;
  document.querySelectorAll('.map-tool-btn[data-tool]').forEach(b => {
    b.classList.toggle('active', b.dataset.tool === tool);
  });
  document.getElementById('mapPlaceDeviceBtn')?.classList.toggle('active', tool === 'place-device');
  if (FP.canvas) {
    FP.canvas.style.cursor = tool === 'select' ? 'default' : (tool === 'place-device' ? 'cell' : 'crosshair');
  }
}
function fpGetBounds() {
  const add = (x, y, pad = 0) => {
    if (!isFinite(x) || !isFinite(y)) return;
    minX = Math.min(minX, x - pad); maxX = Math.max(maxX, x + pad);
    minY = Math.min(minY, y - pad); maxY = Math.max(maxY, y + pad);
  };
  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
  (FP.elements || []).forEach(el => {
    if (el.type === 'wall') { add(el.x, el.y); add(el.x2, el.y2); }
    else if (el.type === 'window' || el.type === 'door') {
      const ext = fpOpeningHalfExtents(el);
      add(el.x, el.y, Math.max(ext.x, ext.y));
    }
    else if (el.type === 'device') { add(el.x, el.y, 24 * (el.scale || 1)); }
    else if (el.type === 'furniture') {
      if (fpElShape(el) === 'poly') el.points.forEach(p => add(p.x, p.y));
      else { add(el.x, el.y, (el.w || 40) / 2); }
    } else if (el.type === 'room') {
      if (fpElShape(el) === 'poly') el.points.forEach(p => add(p.x, p.y));
      else { add(el.x, el.y); add(el.x + (el.w || 0), el.y + (el.h || 0)); }
    } else if (el.type === 'room-label') { add(el.x, el.y, 40); }
  });
  if (!isFinite(minX)) return null;
  return { minX, maxX, minY, maxY };
}
function fpCenterMap(padPx = 56) {
  const b = fpGetBounds();
  const W = FP._sizeW || FP.canvas?.width || 800;
  const H = FP._sizeH || FP.canvas?.height || 500;
  if (!b) {
    FP.panX = 0; FP.panY = 0; FP.zoom = 1;
  } else {
    const bw = Math.max(b.maxX - b.minX, FP.snap * 6);
    const bh = Math.max(b.maxY - b.minY, FP.snap * 6);
    const cx = (b.minX + b.maxX) / 2, cy = (b.minY + b.maxY) / 2;
    FP.zoom = Math.max(0.2, Math.min(5, Math.min((W - padPx * 2) / bw, (H - padPx * 2) / bh)));
    FP.panX = -cx;
    FP.panY = -cy;
  }
  fpRender();
}
function fpHitPolyVertex(el, x, y) {
  if (fpElShape(el) !== 'poly') return -1;
  const thr = 10 / FP.zoom;
  for (let i = 0; i < el.points.length; i++) {
    if (Math.hypot(x - el.points[i].x, y - el.points[i].y) < thr) return i;
  }
  return -1;
}
function fpPolyVertexEditorRows(el) {
  if (!el.points?.length) return '';
  const vi = Math.min(Math.max(0, FP.polyVertexIdx ?? 0), el.points.length - 1);
  FP.polyVertexIdx = vi;
  const pt = el.points[vi];
  const opts = el.points.map((_, i) =>
    `<option value="${i}"${i === vi ? ' selected' : ''}>${esc(uiText.props_vertex)} ${i + 1}</option>`).join('');
  return `<tr><th>${esc(uiText.props_vertex)}</th><td><select id="polyVertexPick">${opts}</select></td></tr>
    <tr><th>X</th><td><input type="number" data-pvi="${vi}" data-pvk="x" step="${FP.snap}" value="${fpSnap(pt.x)}"></td></tr>
    <tr><th>Y</th><td><input type="number" data-pvi="${vi}" data-pvk="y" step="${FP.snap}" value="${fpSnap(pt.y)}"></td></tr>`;
}
function fpBindPolyVertexPicker() {
  document.getElementById('polyVertexPick')?.addEventListener('change', e => {
    FP.polyVertexIdx = parseInt(e.target.value, 10) || 0;
    fpRenderProps();
    fpRender();
  });
}
function fpBindMapZoom() {
  const bind = (el) => {
    if (!el || el._fpWheelBound) return;
    el._fpWheelBound = true;
    el.addEventListener('wheel', fpWheel, { passive: false });
  };
  bind(document.getElementById('canvasWrap'));
  bind(document.getElementById('canvasStage'));
  bind(FP.canvas);
}
function fpRefillPlaceDeviceSelect() {
  const catSel = document.getElementById('placeDeviceCategory');
  const devSel = document.getElementById('placeDeviceSelect');
  if (!catSel || !devSel) return;
  const cat = catSel.value.trim();
  if (!cat) {
    devSel.innerHTML = '<option value="">—</option>';
    return;
  }
  const devs = (state.devices || []).filter(d => (d.category || '').trim() === cat);
  devSel.innerHTML = '<option value="">—</option>' + devs.map(d =>
    `<option value="${esc(d.id)}">${esc(d.name)}</option>`).join('');
}
function fpOpenPlaceDeviceModal(x, y) {
  FP._placeAt = { x: fpSnap(x), y: fpSnap(y) };
  const cats = getDeviceCategories();
  const catOpts = cats.length
    ? `<option value="">${esc(uiText.map_pick_category)}</option>` + cats.map(c => `<option value="${esc(c)}">${esc(c)}</option>`).join('')
    : `<option value="">${esc(uiText.map_pick_category)}</option>`;
  openModal(`<h2 class="modal-title">${esc(uiText.map_add_device)}</h2>
    <p style="color:var(--text-secondary);font-size:13px;margin-bottom:16px">${esc(uiText.map_place_hint)}: ${fpSnap(x)}, ${fpSnap(y)}</p>
    <div class="form-group"><label>${esc(uiText.device_category)}</label>
      <select id="placeDeviceCategory">${catOpts}</select></div>
    <div class="form-group"><label>${esc(uiText.device_name)}</label><select id="placeDeviceSelect"><option value="">—</option></select></div>
    <div class="form-group"><label>${esc(uiText.props_scale)}</label><input type="number" id="placeDeviceScale" min="0.4" max="4" step="0.1" value="1"></div>
    <button type="button" class="btn btn-primary" id="placeDeviceConfirmBtn">${esc(uiText.map_add_device)}</button>`);
  document.getElementById('placeDeviceCategory')?.addEventListener('change', fpRefillPlaceDeviceSelect);
  fpRefillPlaceDeviceSelect();
  document.getElementById('placeDeviceConfirmBtn')?.addEventListener('click', fpConfirmPlaceDevice);
}
function fpConfirmPlaceDevice() {
  const cat = document.getElementById('placeDeviceCategory')?.value.trim();
  const devId = document.getElementById('placeDeviceSelect')?.value;
  const scale = Math.max(0.4, Math.min(4, parseFloat(document.getElementById('placeDeviceScale')?.value || '1') || 1));
  if (!cat) { uiAlert(uiText.device_category); return; }
  if (!devId) { uiAlert(uiText.device_name); return; }
  const p = FP._placeAt;
  if (!p) { closeModal(); return; }
  const existing = FP.elements.findIndex(el => el.type === 'device' && el.deviceId === devId);
  if (existing >= 0) {
    FP.elements[existing].x = p.x; FP.elements[existing].y = p.y; FP.elements[existing].scale = scale;
    fpNormalizeElement(FP.elements[existing]);
    fpSelectEl(existing);
  } else {
    const i = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'device', x: p.x, y: p.y, deviceId: devId, scale }));
    fpSelectEl(i);
  }
  fpPushHistory(); fpSave();
  closeModal();
  FP._placeAt = null;
  fpSetTool('select');
}
function fpDeleteSelected() {
  if (fpIsViewOnly()) return;
  const idx = FP.propsIdx >= 0 ? FP.propsIdx : FP.selected;
  if (idx < 0 || !FP.elements[idx]) return;
  FP.elements.splice(idx, 1);
  FP.selected = -1;
  FP.propsIdx = -1;
  fpPushHistory();
  fpRender();
  fpSave();
  fpRenderProps();
}
function fpCancelAction() {
  FP.vertexDrag = -1;
  if (FP.polyPoints?.length) { FP.polyPoints = null; fpRender(); return; }
  if (FP.drawing) { FP.drawing = false; fpRender(); return; }
  if (FP.dragging) { FP.dragging = false; FP.dragEl = -1; fpRender(); return; }
  if (FP.panning) fpEndPan();
  FP.boxSelect = null;
  FP.selected = -1;
  FP.propsIdx = -1;
  fpRenderProps();
  fpRender();
}
const FP_TOOL_KEYS = { v: 'select', 1: 'select', 2: 'wall', 3: 'window', 4: 'door', 5: 'furniture', 6: 'room', 7: 'floor', 8: 'room-label', 9: 'room-poly', 0: 'furniture-poly' };
let fpKeyboardBound = false;
function fpOnKeyDown(e) {
  if (!fpIsMapVisible() || !FP.canvas || fpMapInputBlocked()) return;
  const key = e.key;
  const mod = e.ctrlKey || e.metaKey;
  if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(key)) {
    e.preventDefault();
    const step = (e.shiftKey ? 72 : 24) / FP.zoom;
    if (key === 'ArrowLeft') fpPanBy(step, 0);
    else if (key === 'ArrowRight') fpPanBy(-step, 0);
    else if (key === 'ArrowUp') fpPanBy(0, step);
    else fpPanBy(0, -step);
    return;
  }
  if (key === '+' || key === '=') { e.preventDefault(); FP.zoom = Math.min(FP.zoom * 1.2, 5); fpRender(); return; }
  if (key === '-' || key === '_') { e.preventDefault(); FP.zoom = Math.max(FP.zoom / 1.2, 0.2); fpRender(); return; }
  if (key === '0' && mod) { e.preventDefault(); FP.zoom = 1; FP.panX = 0; FP.panY = 0; fpRender(); return; }
  if (fpIsViewOnly()) return;
  if (mod && key.toLowerCase() === 'z' && !e.shiftKey) { e.preventDefault(); fpUndo(); return; }
  if (mod && (key.toLowerCase() === 'y' || (key.toLowerCase() === 'z' && e.shiftKey))) { e.preventDefault(); fpRedo(); return; }
  if (mod && key.toLowerCase() === 's') { e.preventDefault(); fpSave(); const btn = document.getElementById('mapSaveBtn'); if (btn) { const orig = btn.innerHTML; btn.textContent = uiText.map_saved; setTimeout(() => { btn.innerHTML = orig; }, 1500); } return; }
  if (key === 'Escape') { e.preventDefault(); fpCancelAction(); return; }
  if (key === 'Enter' && FP.polyPoints?.length >= 3) { e.preventDefault(); fpFinishPolygon(); return; }
  if (key === 'Delete' || key === 'Backspace') { e.preventDefault(); fpDeleteSelected(); return; }
  const tk = FP_TOOL_KEYS[key.toLowerCase()];
  if (tk) { e.preventDefault(); fpSetTool(tk); }
}
function fpSetupKeyboard() {
  if (fpKeyboardBound) return;
  fpKeyboardBound = true;
  document.addEventListener('keydown', fpOnKeyDown);
}
function fpUpdateMapPanelTitle() {
  const h = document.getElementById('mapPropsTitle');
  if (h) h.textContent = fpIsViewOnly() ? (uiText.map_device_states || uiText.params) : uiText.props_title;
}
function fpDeviceStatusColor(status) {
  return status === 'online' ? '#6aaa6a' : status === 'offline' ? '#d4504a' : '#787775';
}
const FP_ICON_CACHE = {};
function fpDeviceIconSvg(icon, color) {
  const raw = getIconSvg(icon || 'smart-device');
  const inner = raw.replace(/^<svg[^>]*>/i, '').replace(/<\/svg>\s*$/i, '');
  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.9">${inner}</svg>`;
}
function fpEnsureDeviceIcon(icon, color) {
  const key = (icon || 'smart-device') + '|' + color;
  if (!FP_ICON_CACHE[key]) {
    const img = new Image();
    const entry = { img, ok: false };
    img.onload = () => { entry.ok = true; fpRender(); };
    img.onerror = () => { entry.ok = false; };
    img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(fpDeviceIconSvg(icon, color));
    FP_ICON_CACHE[key] = entry;
  }
  return FP_ICON_CACHE[key];
}
function fpDrawDeviceMarker(ctx, el, sel) {
  const dev = fpGetDevice(el.deviceId);
  const status = dev?.status || 'unknown';
  const color = fpDeviceStatusColor(status);
  const scale = Math.max(0.4, Math.min(4, parseFloat(el.scale) || 1));
  const size = (sel ? 38 : 34) * scale;
  const r = size / 2;
  const lbl = dev?.name || el.deviceId || '';
  const labelFont = Math.max(8, Math.round(9 * scale));
  ctx.shadowColor = status === 'online' ? 'rgba(106,170,106,0.35)' : 'transparent';
  ctx.shadowBlur = status === 'online' ? 12 : 0;
  ctx.fillStyle = sel ? 'rgba(89,179,0,0.28)' : 'rgba(36,35,33,0.94)';
  ctx.strokeStyle = sel ? '#59b300' : color;
  ctx.lineWidth = sel ? 2 : 1.5;
  ctx.beginPath();
  ctx.arc(el.x, el.y, r, 0, Math.PI * 2);
  ctx.fill();
  ctx.stroke();
  ctx.shadowBlur = 0;
  const ic = fpEnsureDeviceIcon(dev?.icon, color);
  if (ic.ok) {
    const s = Math.max(size * 0.72, size - 10);
    ctx.drawImage(ic.img, el.x - s / 2, el.y - s / 2, s, s);
  }
  ctx.fillStyle = '#e4e3e1';
  ctx.font = 'bold ' + labelFont + 'px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.fillText(lbl.length > 12 ? lbl.slice(0, 11) + '…' : lbl, el.x, el.y + r + Math.max(8, 8 * scale));
}
function fpMapDeviceStatesHtml(d) {
  const vis = visibleParams(d);
  const params = (d.displayed_params?.length ? d.displayed_params.filter(p => !isHiddenParam(p)) : vis);
  if (!params.length) return `<p class="map-view-empty">${esc(uiText.empty_value)}</p>`;
  return `<div class="map-view-states">${params.map(p =>
    `<div class="map-view-state-row"><span class="map-view-state-label">${esc(p.label || '')}</span><span class="map-view-state-val">${esc(String(p.value ?? ''))}</span></div>`
  ).join('')}</div>`;
}
function fpIsMapMobile() { return window.innerWidth < 640; }
function fpMapDeviceDetailHtml(dev) {
  const ctrls = getPreviewControls(dev);
  const paramsHtml = fpMapDeviceStatesHtml(dev);
  const ctrlsHtml = ctrls.length
    ? `<p class="popup-section-title">${esc(uiText.controls)}</p><div class="map-view-controls">${renderControlsHtml(dev, ctrls, true)}</div>`
    : '';
  return `<div class="map-view-device-head" id="mapDevicePopupTitle">
      <div class="map-view-device-icon">${getIconSvg(dev.icon || 'smart-device')}</div>
      <div><div class="map-view-device-name">${esc(dev.name)}</div>
      <div class="map-view-device-status"><span class="status-dot-sm ${dev.status || 'unknown'}"></span>${esc(fpMapStatusLabel(dev.status))}</div></div>
    </div>${paramsHtml ? `<p class="popup-section-title">${esc(uiText.params)}</p>${paramsHtml}` : ''}${ctrlsHtml}`;
}
function fpOpenDevicePopup(dev) {
  const popupBody = document.getElementById('mapDevicePopupBody');
  const popup = document.getElementById('mapDevicePopup');
  if (popupBody) popupBody.innerHTML = fpMapDeviceDetailHtml(dev);
  popup?.classList.add('active');
}
function fpMapStatusLabel(status) {
  if (status === 'online') return uiText.status_online;
  if (status === 'offline') return uiText.status_offline;
  return uiText.status_unknown;
}
function fpRoomCanvasLabel(el) {
  const name = el.text || 'Room';
  if (fpIsViewOnly()) return name;
  const opt = FP_FLOOR_OPTS.find(o => o.v === (el.floorType || 'wood'));
  return name + ' · ' + (opt ? opt.l() : (el.floorType || ''));
}

function fpUpdateMapMode() {
  const page = document.getElementById('page-map');
  const stage = document.getElementById('canvasStage');
  if (!page) return;
  page.classList.toggle('map-view-only', fpIsViewOnly());
  fpUpdateMapPanelTitle();
  if (FP.canvas) {
    FP.canvas.style.cursor = fpIsViewOnly() ? 'default' : (FP.tool === 'select' ? 'default' : 'crosshair');
  }
  if (fpIsViewOnly()) {
    FP.tool = 'select';
    FP.drawing = false;
    FP.dragging = false;
    FP.dragEl = -1;
    FP.polyPoints = null;
    FP.vertexDrag = -1;
    document.getElementById('mapPlaceDeviceBtn')?.classList.remove('active');
  }
  fpRebuildDeviceChips();
  fpRenderProps();
  fpRender();
  syncViewportMode();
}

function fpSave() {
  if (fpIsViewOnly()) return;
  fpNormalizeElements();
  state.floorPlan = FP.elements;
  api('save_floor_plan', { elements: FP.elements }).catch(e => console.error('floor plan save', e));
}
function fpPushHistory() {
  FP.histIdx++;
  FP.history = FP.history.slice(0, FP.histIdx);
  FP.history.push(JSON.parse(JSON.stringify(FP.elements)));
  if (FP.history.length > 50) FP.history.shift();
}
function fpUndo() {
  if (FP.histIdx > 0) { FP.histIdx--; FP.elements = JSON.parse(JSON.stringify(FP.history[FP.histIdx])); fpRender(); fpSave(); }
}
function fpRedo() {
  if (FP.histIdx < FP.history.length - 1) { FP.histIdx++; FP.elements = JSON.parse(JSON.stringify(FP.history[FP.histIdx])); fpRender(); fpSave(); }
}

function fpResizeCanvas() {
  const canvas = FP.canvas;
  const stage = document.getElementById('canvasStage');
  if (!canvas || !stage) return;
  const w = stage.clientWidth;
  const h = stage.clientHeight;
  if (w < 1 || h < 1) return;
  if (FP._sizeW === w && FP._sizeH === h) return;
  FP._sizeW = w;
  FP._sizeH = h;
  canvas.width = w;
  canvas.height = h;
  fpRender();
  if (!FP._centeredOnce) { FP._centeredOnce = true; fpCenterMap(); }
}

function fpInit() {
  const canvas = document.getElementById('floorPlanCanvas');
  if (!canvas || FP.canvas) return;
  FP.canvas = canvas;
  FP.ctx = canvas.getContext('2d');
  fpLoad();
  if (FP.history.length === 0) { fpPushHistory(); }
  let fpTouchTap = null;
  canvas.addEventListener('mousedown', e => fpMouseDown(e));
  canvas.addEventListener('mousemove', e => fpMouseMove(e));
  canvas.addEventListener('mouseup', e => fpMouseUp(e));
  canvas.addEventListener('mouseleave', e => fpMouseUp(e));
  canvas.addEventListener('contextmenu', e => { if (fpIsMapVisible()) e.preventDefault(); });
  canvas.addEventListener('touchstart', e => {
    if (!fpIsMapVisible()) return;
    e.preventDefault();
    const p = fpTouch(e);
    fpTouchTap = { x: p.clientX, y: p.clientY };
    fpMouseDown(p);
  }, { passive: false });
  canvas.addEventListener('touchmove', e => {
    if (!fpIsMapVisible()) return;
    e.preventDefault();
    fpMouseMove(fpTouch(e));
  }, { passive: false });
  canvas.addEventListener('touchend', e => {
    if (!fpIsMapVisible()) return;
    e.preventDefault();
    const p = fpTouch(e);
    if (fpTouchTap && fpIsViewOnly()) {
      const dx = p.clientX - fpTouchTap.x, dy = p.clientY - fpTouchTap.y;
      if (Math.hypot(dx, dy) < 14) {
        const c = fpCanvasCoords(p);
        const hitIdx = fpFindViewDevice(c.x, c.y);
        if (hitIdx >= 0) fpSelectEl(hitIdx);
        else { FP.selected = -1; FP.propsIdx = -1; fpCloseDevicePopup(); fpRenderProps(); fpRender(); }
      }
    }
    fpTouchTap = null;
    fpMouseUp(p);
  }, { passive: false });
  canvas.addEventListener('wheel', fpWheel, { passive: false });
  fpBindMapZoom();
  canvas.addEventListener('dblclick', fpDblClick);
  document.querySelectorAll('.map-tool-btn[data-tool]').forEach(b => {
    b.addEventListener('click', () => { if (!fpIsViewOnly()) fpSetTool(b.dataset.tool); });
  });
  document.getElementById('mapPlaceDeviceBtn')?.addEventListener('click', () => {
    if (!fpIsViewOnly()) fpSetTool('place-device');
  });
  fpSetupKeyboard();
  document.getElementById('mapUndoBtn')?.addEventListener('click', fpUndo);
  document.getElementById('mapRedoBtn')?.addEventListener('click', fpRedo);
  document.getElementById('mapZoomInBtn')?.addEventListener('click', () => { FP.zoom = Math.min(FP.zoom * 1.2, 5); fpRender(); });
  document.getElementById('mapZoomOutBtn')?.addEventListener('click', () => { FP.zoom = Math.max(FP.zoom / 1.2, 0.2); fpRender(); });
  document.getElementById('mapClearBtn')?.addEventListener('click', () => {
    if (FP.elements.length === 0) return;
    uiConfirm(uiText.map_clear_confirm, () => { FP.elements = []; FP.selected = -1; FP.propsIdx = -1; fpPushHistory(); fpRenderProps(); fpRender(); fpSave(); }, null, { danger: true });
  });
  document.getElementById('mapSaveBtn')?.addEventListener('click', () => {
    fpSave();
    const btn = document.getElementById('mapSaveBtn');
    const orig = btn.innerHTML;
    btn.textContent = uiText.map_saved;
    setTimeout(() => { btn.innerHTML = orig; }, 1500);
  });
  fpRebuildDeviceChips();
  fpResizeCanvas();
  if (FP.resizeObs) FP.resizeObs.disconnect();
  const stage = document.getElementById('canvasStage');
  FP.resizeObs = new ResizeObserver(() => fpResizeCanvas());
  if (stage) FP.resizeObs.observe(stage);
  fpEnsurePropsAutoSave();
  document.getElementById('mapPropsDelete')?.addEventListener('click', () => {
    if (FP.propsIdx < 0) return;
    uiConfirm(uiText.map_delete_el, () => {
      FP.elements.splice(FP.propsIdx, 1);
      FP.selected = -1; FP.propsIdx = -1;
      fpPushHistory(); fpRender(); fpSave(); fpRenderProps();
    }, null, { danger: true, okLabel: uiText.props_delete });
  });
  fpUpdateMapMode();
  fpRenderProps();
  if (!FP._centeredOnce) { FP._centeredOnce = true; setTimeout(() => fpCenterMap(), 50); }
}

function fpTypeLabel(type) {
  const m = { wall: uiText.map_wall, window: uiText.map_window, door: uiText.map_door, furniture: uiText.map_furniture,
    room: uiText.map_room, 'room-label': uiText.map_room, device: uiText.props_device, 'room-poly': uiText.map_room_poly, 'furniture-poly': uiText.map_furniture_poly };
  return m[type] || type;
}
function fpScaleRow(el) {
  if (el.type !== 'room' && el.type !== 'furniture' && el.type !== 'device') return '';
  const s = el.scale ?? 1;
  const min = el.type === 'device' ? 0.4 : 0.1;
  const max = el.type === 'device' ? 4 : 10;
  return `<tr><th>${esc(uiText.props_scale)}</th><td><input type="number" data-k="scale" step="0.1" min="${min}" max="${max}" value="${s}"></td></tr>`;
}

let fpPropsAutoSaveBound = false;
function fpEnsurePropsAutoSave() {
  if (fpPropsAutoSaveBound) return;
  const body = document.getElementById('mapPropsBody');
  if (!body) return;
  fpPropsAutoSaveBound = true;
  let tm = null;
  body.addEventListener('input', e => {
    if (fpIsViewOnly() || !e.target.matches('[data-k]')) return;
    clearTimeout(tm);
    tm = setTimeout(() => fpApplyProps(true), 400);
  });
  body.addEventListener('change', e => {
    if (fpIsViewOnly() || !e.target.matches('[data-k]')) return;
    fpApplyProps(true);
  });
}

function fpRenderViewSidebar(idx) {
  const body = document.getElementById('mapPropsBody');
  const actions = document.getElementById('mapPropsActions');
  if (actions) actions.style.display = 'none';
  if (!body) return;
  if (idx < 0 || !FP.elements[idx]) {
    body.className = 'map-props-empty';
    body.innerHTML = esc(uiText.props_none);
    fpCloseDevicePopup();
    return;
  }
  const el = FP.elements[idx];
  if (el.type === 'device') {
    const dev = fpGetDevice(el.deviceId);
    if (!dev) {
      body.className = 'map-props-empty';
      body.innerHTML = esc(uiText.props_none);
      fpCloseDevicePopup();
      return;
    }
    FP.propsIdx = idx;
    const detailHtml = fpMapDeviceDetailHtml(dev);
    if (fpIsMapMobile()) {
      body.className = 'map-props-empty';
      body.innerHTML = esc(uiText.props_none);
      fpOpenDevicePopup(dev);
    } else {
      body.className = 'map-view-device-panel';
      body.innerHTML = detailHtml;
      fpCloseDevicePopup();
    }
    return;
  }
  body.className = 'map-props-empty';
  body.innerHTML = esc(uiText.props_none);
  fpCloseDevicePopup();
}

function fpCloseDevicePopup() {
  const popup = document.getElementById('mapDevicePopup');
  if (popup) popup.classList.remove('active');
}

function fpRenderProps() {
  const body = document.getElementById('mapPropsBody');
  const actions = document.getElementById('mapPropsActions');
  if (!body) return;
  const idx = FP.propsIdx >= 0 ? FP.propsIdx : FP.selected;
  if (fpIsViewOnly()) {
    fpRenderViewSidebar(idx);
    fpHighlightHomeDeviceCard(idx);
    return;
  }
  if (idx < 0 || !FP.elements[idx]) {
    body.className = 'map-props-empty';
    body.innerHTML = esc(uiText.props_none);
    if (actions) actions.style.display = 'none';
    return;
  }
  const el = FP.elements[idx];
  body.className = '';
  let rows = `<tr><th>${esc(uiText.props_type)}</th><td>${esc(fpTypeLabel(el.type))}</td></tr>`;
  const num = (k, label, step) => `<tr><th>${esc(label)}</th><td><input type="number" data-k="${k}" step="${step ?? FP.snap}" value="${Number(el[k]??0)}"></td></tr>`;
  const txt = (k, label) => `<tr><th>${esc(label)}</th><td><input type="text" data-k="${k}" value="${esc(String(el[k]??''))}"></td></tr>`;
  const chk = (k, label, checked) => `<tr><th>${esc(label)}</th><td><label style="display:flex;align-items:center;gap:8px"><input type="checkbox" data-k="${k}" ${checked ? 'checked' : ''}><span>${checked ? 'On' : 'Off'}</span></label></td></tr>`;
  const cornerRows = fpSupportsRounded(el)
    ? chk('rounded', uiText.props_rounded || 'Rounded', el.rounded !== undefined ? !!el.rounded : fpElementDefaultRounded(el))
      + num('cornerRadius', uiText.props_corner_radius || 'Corner radius', 1)
    : '';
  if (el.type === 'room') {
    rows += txt('text', uiText.props_text);
    rows += `<tr><th>${esc(uiText.props_floor)}</th><td><select data-k="floorType">${FP_FLOOR_OPTS.map(o => `<option value="${o.v}" ${el.floorType===o.v?'selected':''}>${esc(o.l())}</option>`).join('')}</select></td></tr>`;
    rows += fpScaleRow(el);
    rows += cornerRows;
    if (fpElShape(el) === 'poly') rows += fpPolyVertexEditorRows(el);
    else rows += num('x', uiText.props_x, FP.snap) + num('y', uiText.props_y, FP.snap) + num('w', uiText.props_w, FP.snap) + num('h', uiText.props_h, FP.snap);
  } else if (el.type === 'room-label') {
    rows += txt('text', uiText.props_text) + cornerRows + num('x', uiText.props_x, 1) + num('y', uiText.props_y, 1) + num('fontSize', uiText.props_h, 1);
  } else if (el.type === 'furniture') {
    rows += txt('label', uiText.props_label);
    rows += fpScaleRow(el);
    rows += cornerRows;
    if (fpElShape(el) === 'poly') rows += fpPolyVertexEditorRows(el);
    else rows += num('x', uiText.props_x, FP.snap) + num('y', uiText.props_y, FP.snap) + num('w', uiText.props_w, FP.snap) + num('h', uiText.props_h, FP.snap);
  } else if (el.type === 'wall') {
    rows += num('x', uiText.props_x + '1', FP.snap) + num('y', uiText.props_y + '1', FP.snap) + num('x2', uiText.props_x + '2', FP.snap) + num('y2', uiText.props_y + '2', FP.snap);
  } else if (el.type === 'window' || el.type === 'door') {
    rows += num('x', uiText.props_x, FP.snap) + num('y', uiText.props_y, FP.snap) + num('w', uiText.props_w, FP.snap);
    rows += num('angle', 'Angle', 0.01);
  } else if (el.type === 'device') {
    const dev = fpGetDevice(el.deviceId);
    rows += `<tr><th>${esc(uiText.props_device)}</th><td>${esc(dev?.name || el.deviceId)}</td></tr>`;
    rows += fpScaleRow(el);
    rows += num('x', uiText.props_x, FP.snap) + num('y', uiText.props_y, FP.snap);
  }
  body.innerHTML = `<table class="props-table"><thead><tr><th>${esc(uiText.props_name)}</th><th>${esc(uiText.props_value)}</th></tr></thead><tbody>${rows}</tbody></table>`;
  if (actions) actions.style.display = 'flex';
  fpBindPolyVertexPicker();
}

function fpApplyProps(silent) {
  if (fpIsViewOnly()) return;
  const idx = FP.propsIdx >= 0 ? FP.propsIdx : FP.selected;
  if (idx < 0 || !FP.elements[idx]) return;
  const el = FP.elements[idx];
  document.querySelectorAll('#mapPropsBody [data-k], #mapPropsBody [data-pvi]').forEach(inp => {
    if (inp.dataset.pvi !== undefined) {
      const i = parseInt(inp.dataset.pvi, 10);
      const pk = inp.dataset.pvk;
      if (el.points?.[i] && (pk === 'x' || pk === 'y')) el.points[i][pk] = fpSnap(parseFloat(inp.value) || 0);
      return;
    }
    const k = inp.dataset.k;
    let v = inp.value;
    if (k === 'scale') { fpApplyElementScale(el, v); return; }
    if (inp.type === 'checkbox') v = inp.checked;
    if (inp.type === 'number') v = parseFloat(v);
    if (['x','y','x2','y2','w','h','fontSize'].includes(k)) el[k] = fpSnap(Number(v) || 0);
    else el[k] = v;
  });
  fpNormalizeElement(el);
  if (el.type === 'room' && el.w < 20) el.w = 80;
  if (el.type === 'room' && el.h < 20) el.h = 60;
  if (!silent) fpPushHistory();
  fpRender();
  fpSave();
}

function fpHighlightHomeDeviceCard() {}

function fpSelectEl(idx) {
  FP.selected = idx;
  FP.propsIdx = idx;
  const el = FP.elements[idx];
  if (el && fpElShape(el) === 'poly') FP.polyVertexIdx = 0;
  fpRenderProps();
  fpHighlightHomeDeviceCard(idx);
  fpRender();
}

function fpRebuildDeviceChips() {}

function fpPointerButton(e) { return typeof e.button === 'number' ? e.button : 0; }
function fpTouch(e) {
  const t = e.touches?.[0] || e.changedTouches?.[0];
  if (!t) return e;
  return { clientX: t.clientX, clientY: t.clientY, button: 0, isTouch: true };
}
function fpDeviceHitRadius() { return fpIsViewOnly() ? Math.max(28, 40 / FP.zoom) : 22; }
function fpDevicePickRadius() { return Math.max(36, 50 / FP.zoom); }
function fpFindViewDevice(cx, cy) {
  const pickR = fpDevicePickRadius();
  const hits = [];
  for (let i = 0; i < FP.elements.length; i++) {
    const el = FP.elements[i];
    if (el.type !== 'device') continue;
    const hr = fpDeviceHitRadius() * (el.scale || 1);
    const d = Math.hypot(cx - el.x, cy - el.y);
    if (d <= pickR + hr) hits.push({ i, d });
  }
  if (!hits.length) return -1;
  hits.sort((a, b) => a.d - b.d);
  const minGap = Math.max(10, 14 / FP.zoom);
  for (let j = 1; j < hits.length; j++) {
    if (hits[j].d <= pickR && hits[j].d - hits[0].d < minGap) return -1;
  }
  return hits[0].i;
}
function fpCanvasCoords(e) {
  const r = FP.canvas.getBoundingClientRect();
  const x = ((e.clientX - r.left) / r.width * FP.canvas.width - FP.canvas.width / 2) / FP.zoom - FP.panX;
  const y = ((e.clientY - r.top) / r.height * FP.canvas.height - FP.canvas.height / 2) / FP.zoom - FP.panY;
  return { x, y };
}

function fpSnap(v) { return Math.round(v / FP.snap) * FP.snap; }
function fpSnapPoint(p) { return { x: fpSnap(p.x), y: fpSnap(p.y) }; }
function fpEditCoords(e) { return fpSnapPoint(fpCanvasCoords(e)); }

function fpMouseDown(e) {
  if (fpIsPanButton(e)) {
    e.preventDefault();
    fpStartPan(e);
    return;
  }
  if (fpPointerButton(e) !== 0) return;
  const p = fpIsViewOnly() ? fpCanvasCoords(e) : fpEditCoords(e);
  const hitIdx = fpFindEl(p.x, p.y);
  if (fpIsViewOnly()) {
    if (hitIdx >= 0) fpSelectEl(hitIdx);
    else {
      FP.selected = -1; FP.propsIdx = -1;
      fpCloseDevicePopup();
      fpRenderProps(); fpRender();
    }
    return;
  }
  if (FP.tool === 'place-device') {
    fpOpenPlaceDeviceModal(p.x, p.y);
    return;
  }
  if (FP.tool === 'select') {
    const idx = hitIdx;
    if (idx < 0) {
      FP.boxSelect = { x1: p.x, y1: p.y, x2: p.x, y2: p.y, active: true };
      FP.selected = -1; FP.propsIdx = -1; FP.vertexDrag = -1;
      fpRenderProps(); fpRender();
      return;
    }
    const el = FP.elements[idx];
    const vi = fpHitPolyVertex(el, p.x, p.y);
    if (vi >= 0 && fpElShape(el) === 'poly') {
      FP.polyVertexIdx = vi;
      fpSelectEl(idx);
      FP.vertexDrag = vi;
      FP.dragEl = idx;
      fpRender();
      return;
    }
    fpSelectEl(idx);
    FP.dragging = true;
    FP.dragEl = idx;
    if (el.type === 'wall') {
      FP.dragOffX = p.x; FP.dragOffY = p.y;
      FP._wallOx = el.x; FP._wallOy = el.y; FP._wallOx2 = el.x2; FP._wallOy2 = el.y2;
    } else if ((el.type === 'room' || el.type === 'furniture') && fpElShape(el) === 'poly') {
      FP._polyDragStart = el.points.map(pt => ({ x: pt.x, y: pt.y }));
      FP.dragOffX = p.x; FP.dragOffY = p.y;
    } else if (el.type === 'room') {
      FP.dragOffX = p.x - el.x; FP.dragOffY = p.y - el.y;
    } else if (el.type === 'furniture') {
      FP.dragOffX = p.x - el.x; FP.dragOffY = p.y - el.y;
    } else {
      FP.dragOffX = p.x - (el.x || 0); FP.dragOffY = p.y - (el.y || 0);
    }
    fpRender();
    return;
  }
  if (fpIsPolyTool(FP.tool)) {
    if (!FP.polyPoints) FP.polyPoints = [];
    if (FP.polyPoints.length >= 3 && Math.hypot(p.x - FP.polyPoints[0].x, p.y - FP.polyPoints[0].y) < 16 / FP.zoom) {
      fpFinishPolygon();
      return;
    }
    FP.polyPoints.push({ x: p.x, y: p.y });
    fpRender();
    return;
  }
  if (FP.tool === 'room-label') {
    const i = FP.elements.length;
    FP.elements.push({ type: 'room-label', x: p.x, y: p.y, text: 'Room', fontSize: 16 });
    fpPushHistory(); fpSelectEl(i); fpSave();
    return;
  }
  if (FP.tool === 'furniture') {
    const i = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'furniture', x: p.x, y: p.y, w: 60, h: 40, label: 'table', scale: 1 }));
    fpPushHistory(); fpSelectEl(i); fpSave();
    return;
  }
  FP.drawing = true;
  FP.sX = p.x; FP.sY = p.y;
  FP.currX = p.x; FP.currY = p.y;
}

function fpMouseMove(e) {
  const p = fpIsViewOnly() ? fpCanvasCoords(e) : fpEditCoords(e);
  if (FP.panning) {
    FP.panX = FP.panOriginX + (e.clientX - FP.panStartCX) / FP.zoom;
    FP.panY = FP.panOriginY + (e.clientY - FP.panStartCY) / FP.zoom;
    fpRender();
    return;
  }
  if (FP.boxSelect?.active) {
    FP.boxSelect.x2 = p.x;
    FP.boxSelect.y2 = p.y;
    fpRender();
    return;
  }
  if (fpIsViewOnly()) {
    const sb = document.getElementById('mapStatus');
    if (sb) sb.textContent = Math.round(FP.zoom * 100) + '%';
    return;
  }
  if (FP.vertexDrag >= 0 && FP.dragEl >= 0) {
    const el = FP.elements[FP.dragEl];
    if (el.points?.[FP.vertexDrag]) {
      el.points[FP.vertexDrag] = { x: p.x, y: p.y };
      FP.polyVertexIdx = FP.vertexDrag;
      fpRenderProps();
      fpRender();
    }
    return;
  }
  if (FP.dragging && FP.dragEl >= 0) {
    const el = FP.elements[FP.dragEl];
    if (el.type === 'wall') {
      const dx = p.x - FP.dragOffX, dy = p.y - FP.dragOffY;
      el.x = FP._wallOx + dx; el.y = FP._wallOy + dy; el.x2 = FP._wallOx2 + dx; el.y2 = FP._wallOy2 + dy;
    } else if (fpElShape(el) === 'poly' && FP._polyDragStart) {
      const dx = p.x - FP.dragOffX, dy = p.y - FP.dragOffY;
      el.points = FP._polyDragStart.map(pt => ({ x: fpSnap(pt.x + dx), y: fpSnap(pt.y + dy) }));
    } else {
      el.x = fpSnap(p.x - FP.dragOffX); el.y = fpSnap(p.y - FP.dragOffY);
    }
    fpNormalizeElement(el);
    fpRenderProps();
    fpRender();
    return;
  }
  if (FP.drawing) {
    FP.currX = p.x; FP.currY = p.y;
    fpRender();
  }
  if (FP.polyPoints?.length) FP._polyCurr = p;
  const sb = document.getElementById('mapStatus');
  if (sb) {
    const hint = fpIsPolyTool(FP.tool) ? (uiText.map_poly_hint || '') : FP.tool;
    sb.textContent = 'X:' + Math.round(p.x) + ' Y:' + Math.round(p.y) + ' | ' + hint + ' | ' + Math.round(FP.zoom * 100) + '%';
  }
}

function fpMouseUp(e) {
  if (FP.panning) { fpEndPan(); return; }
  if (FP.boxSelect?.active) { fpFinishBoxSelect(); return; }
  if (fpIsViewOnly()) return;
  if (FP.vertexDrag >= 0 || FP.dragging) {
    const el = FP.elements[FP.dragEl];
    if (el) fpNormalizeElement(el);
    if (FP.vertexDrag >= 0 && el?.points) {
      el.points[FP.vertexDrag] = { x: fpSnap(el.points[FP.vertexDrag].x), y: fpSnap(el.points[FP.vertexDrag].y) };
    }
    FP.vertexDrag = -1;
    FP.dragging = false; FP.dragEl = -1; FP._polyDragStart = null;
    fpPushHistory(); fpSave(); return;
  }
  if (!FP.drawing) return;
  FP.drawing = false;
  const p = fpEditCoords(e);
  const x1 = FP.sX, y1 = FP.sY, x2 = p.x, y2 = p.y;
  const dist = Math.sqrt((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1));
  if (dist < FP.snap) return;
  let newIdx = -1;
  const seg = fpAlignedSegment(x1, y1, x2, y2);
  const len = fpSegmentLength(seg.x1, seg.y1, seg.x2, seg.y2);
  if (FP.tool === 'wall') {
    newIdx = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'wall', x: seg.x1, y: seg.y1, x2: seg.x2, y2: seg.y2 }));
  } else if (FP.tool === 'window') {
    newIdx = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'window', x: (seg.x1 + seg.x2) / 2, y: (seg.y1 + seg.y2) / 2, w: fpSnapSize(len), h: FP.snap, angle: Math.atan2(seg.y2 - seg.y1, seg.x2 - seg.x1), scale: 1 }));
  } else if (FP.tool === 'door') {
    newIdx = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'door', x: (seg.x1 + seg.x2) / 2, y: (seg.y1 + seg.y2) / 2, w: fpSnapSize(len), h: Math.max(4, FP.snap / 2), angle: Math.atan2(seg.y2 - seg.y1, seg.x2 - seg.x1), scale: 1 }));
  } else if (FP.tool === 'room' || FP.tool === 'floor') {
    const rx = fpSnap(Math.min(x1, x2)), ry = fpSnap(Math.min(y1, y2));
    const rw = Math.max(FP.snap * 4, fpSnap(Math.abs(x2 - x1))), rh = Math.max(FP.snap * 4, fpSnap(Math.abs(y2 - y1)));
    newIdx = FP.elements.length;
    FP.elements.push(fpNormalizeElement({ type: 'room', x: rx, y: ry, w: rw, h: rh, text: 'Room', floorType: 'wood', scale: 1 }));
  }
  if (newIdx >= 0) {
    fpPushHistory(); fpSelectEl(newIdx); fpSave();
  }
}

function fpWheel(e) {
  if (!FP.canvas || !fpIsMapVisible()) return;
  e.preventDefault();
  e.stopPropagation();
  const rect = FP.canvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left) / rect.width * FP.canvas.width;
  const my = (e.clientY - rect.top) / rect.height * FP.canvas.height;
  const wx = (mx - FP.canvas.width / 2) / FP.zoom - FP.panX;
  const wy = (my - FP.canvas.height / 2) / FP.zoom - FP.panY;
  const factor = e.deltaY > 0 ? 0.9 : 1.1;
  const nz = Math.max(0.2, Math.min(5, FP.zoom * factor));
  FP.panX -= wx * (nz / FP.zoom - 1);
  FP.panY -= wy * (nz / FP.zoom - 1);
  FP.zoom = nz;
  fpRender();
}

function fpDblClick(e) {
  if (fpIsViewOnly()) return;
  const p = fpEditCoords(e);
  const idx = fpFindEl(p.x, p.y);
  if (idx < 0) return;
  const el = FP.elements[idx];
  if (fpElShape(el) === 'poly') {
    const vi = fpHitPolyVertex(el, p.x, p.y);
    if (vi >= 0 && el.points.length > 3) {
      el.points.splice(vi, 1);
      fpPushHistory(); fpRender(); fpSave(); fpRenderProps();
      return;
    }
  }
  if (el.type === 'device') {
    const dev = fpGetDevice(el.deviceId);
    if (dev && deviceCanConfigure(dev)) showDeviceSettings(dev.id);
  }
}

function fpFindEl(cx, cy) {
  if (fpIsViewOnly()) return fpFindViewDevice(cx, cy);
  const devR = fpDeviceHitRadius();
  for (let i = FP.elements.length - 1; i >= 0; i--) {
    const el = FP.elements[i];
    if (el.type === 'wall') {
      if (fpDistToSegment(cx, cy, el) < 8 / FP.zoom) return i;
    } else if (el.type === 'window' || el.type === 'door') {
      if (fpPointInOpening(el, cx, cy, 8 / FP.zoom)) return i;
    } else if (el.type === 'device') {
      if (Math.hypot(cx - el.x, cy - el.y) < devR * (el.scale || 1)) return i;
    } else if (el.type === 'furniture') {
      if (fpElShape(el) === 'poly') { if (fpPointInPoly(cx, cy, el.points)) return i; }
      else if (cx >= el.x - el.w/2 && cx <= el.x + el.w/2 && cy >= el.y - el.h/2 && cy <= el.y + el.h/2) return i;
    } else if (el.type === 'room-label') {
      if (Math.abs(cx - el.x) < 60 && Math.abs(cy - el.y) < 12) return i;
    } else if (el.type === 'room') {
      if (fpElShape(el) === 'poly') { if (fpPointInPoly(cx, cy, el.points)) return i; }
      else if (cx >= el.x && cx <= el.x + el.w && cy >= el.y && cy <= el.y + el.h) return i;
    }
  }
  return -1;
}

function fpDistToSegment(px, py, seg) {
  const dx = seg.x2 - seg.x, dy = seg.y2 - seg.y;
  const len2 = dx*dx + dy*dy;
  if (len2 === 0) return Math.sqrt((px-seg.x)*(px-seg.x) + (py-seg.y)*(py-seg.y));
  let t = ((px-seg.x)*dx + (py-seg.y)*dy) / len2;
  t = Math.max(0, Math.min(1, t));
  return Math.sqrt((px-(seg.x+t*dx))*(px-(seg.x+t*dx)) + (py-(seg.y+t*dy))*(py-(seg.y+t*dy)));
}
function fpDrawOpeningGap(ctx, el, wallWidth) {
  ctx.save();
  ctx.translate(el.x, el.y);
  ctx.rotate(el.angle || 0);
  ctx.strokeStyle = '#1f1e1c';
  ctx.lineWidth = wallWidth + 2;
  ctx.lineCap = 'butt';
  ctx.beginPath();
  ctx.moveTo(-el.w / 2, 0);
  ctx.lineTo(el.w / 2, 0);
  ctx.stroke();
  ctx.restore();
}
function fpDrawWindowElement(ctx, el) {
  fpDrawOpeningGap(ctx, el, 4);
  ctx.save();
  ctx.translate(el.x, el.y);
  ctx.rotate(el.angle || 0);
  ctx.strokeStyle = '#64b4ff';
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(-el.w / 2, 0);
  ctx.lineTo(el.w / 2, 0);
  ctx.stroke();
  ctx.strokeStyle = 'rgba(100,180,255,0.45)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(-el.w / 4, -el.h * 0.6);
  ctx.lineTo(-el.w / 4, el.h * 0.6);
  ctx.moveTo(el.w / 4, -el.h * 0.6);
  ctx.lineTo(el.w / 4, el.h * 0.6);
  ctx.stroke();
  ctx.restore();
}
function fpDrawDoorElement(ctx, el) {
  fpDrawOpeningGap(ctx, el, 4);
  ctx.save();
  ctx.translate(el.x, el.y);
  ctx.rotate(el.angle || 0);
  const hingeX = -el.w / 2;
  const w = el.w;
  ctx.strokeStyle = '#c78b52';
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(hingeX, 0);
  ctx.lineTo(hingeX, -w);
  ctx.stroke();
  ctx.strokeStyle = 'rgba(199,139,82,0.55)';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.arc(hingeX, 0, w, -Math.PI / 2, 0, false);
  ctx.stroke();
  ctx.fillStyle = '#ffd700';
  ctx.beginPath();
  ctx.arc(hingeX + 2, -Math.max(6, w * 0.08), 2, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

function fpRender() {
  const ctx = FP.ctx;
  if (!ctx) return;
  const W = FP.canvas.width, H = FP.canvas.height;
  const placedLabelBoxes = [];
  ctx.clearRect(0, 0, W, H);
  ctx.save();
  ctx.translate(W/2 + FP.panX * FP.zoom, H/2 + FP.panY * FP.zoom);
  ctx.scale(FP.zoom, FP.zoom);
  ctx.strokeStyle = 'rgba(255,255,255,0.04)';
  ctx.lineWidth = 0.5;
  const gx0 = Math.floor((-W / 2 / FP.zoom - FP.panX) / FP.snap) * FP.snap - FP.snap * 2;
  const gx1 = Math.ceil((W / 2 / FP.zoom - FP.panX) / FP.snap) * FP.snap + FP.snap * 2;
  const gy0 = Math.floor((-H / 2 / FP.zoom - FP.panY) / FP.snap) * FP.snap - FP.snap * 2;
  const gy1 = Math.ceil((H / 2 / FP.zoom - FP.panY) / FP.snap) * FP.snap + FP.snap * 2;
  for (let x = gx0; x <= gx1; x += FP.snap) { ctx.beginPath(); ctx.moveTo(x, gy0); ctx.lineTo(x, gy1); ctx.stroke(); }
  for (let y = gy0; y <= gy1; y += FP.snap) { ctx.beginPath(); ctx.moveTo(gx0, y); ctx.lineTo(gx1, y); ctx.stroke(); }
  FP.elements.forEach((el, i) => {
    const sel = i === FP.selected && (!fpIsViewOnly() || el.type === 'device');
    ctx.save();
    switch (el.type) {
      case 'wall':
        ctx.strokeStyle = '#8a8a8a';
        ctx.lineWidth = sel ? 5 : 4;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.shadowColor = sel ? 'rgba(89,179,0,0.4)' : 'transparent';
        ctx.shadowBlur = sel ? 8 : 0;
        ctx.beginPath(); ctx.moveTo(el.x, el.y); ctx.lineTo(el.x2, el.y2); ctx.stroke();
        break;
      case 'window':
        fpDrawWindowElement(ctx, el);
        break;
      case 'door':
        fpDrawDoorElement(ctx, el);
        break;
      case 'furniture':
        ctx.fillStyle = sel ? 'rgba(89,179,0,0.3)' : 'rgba(139,119,101,0.4)';
        ctx.strokeStyle = sel ? '#59b300' : '#8b7765';
        ctx.lineWidth = sel ? 2 : 1.5;
        if (fpElShape(el) === 'poly') {
          fpRoundPolyPath(ctx, el.points, fpElementCornerRadius(el));
          ctx.fill(); ctx.stroke();
          if (sel) {
            ctx.fillStyle = '#59b300';
            el.points.forEach((pt, pi) => {
              const active = pi === FP.vertexDrag || pi === FP.polyVertexIdx;
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, active ? 7 : 4, 0, Math.PI * 2);
              ctx.fill();
              ctx.strokeStyle = '#fff';
              ctx.lineWidth = active ? 2 : 1;
              ctx.stroke();
            });
          }
          const label = el.label || '';
          const c = fpFindElementLabelPosition(ctx, el, label, 10, placedLabelBoxes, fpCollectLabelBlockers(el, 'furniture'));
          if (c.ok) {
            placedLabelBoxes.push(c.box);
            ctx.fillStyle = '#c0b0a0';
            ctx.font = '10px sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(label, c.x, c.y);
          }
        } else {
          ctx.shadowColor = 'rgba(0,0,0,0.2)';
          ctx.shadowBlur = 4;
          fpRectPath(ctx, el.x - el.w/2, el.y - el.h/2, el.w, el.h, fpElementCornerRadius(el));
          ctx.fill(); ctx.stroke();
          ctx.shadowBlur = 0;
          const label = el.label || '';
          const c = fpFindElementLabelPosition(ctx, el, label, 10, placedLabelBoxes, fpCollectLabelBlockers(el, 'furniture'));
          if (c.ok) {
            placedLabelBoxes.push(c.box);
            ctx.fillStyle = '#c0b0a0';
            ctx.font = '10px sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(label, c.x, c.y);
          }
        }
        break;
      case 'room':
        const floorColors = { wood: 'rgba(139,90,43,0.35)', tile: 'rgba(180,180,190,0.4)', carpet: 'rgba(100,80,120,0.35)', laminate: 'rgba(200,170,120,0.35)' };
        ctx.fillStyle = sel ? 'rgba(89,179,0,0.2)' : (floorColors[el.floorType] || floorColors.wood);
        ctx.strokeStyle = sel ? '#59b300' : 'rgba(255,255,255,0.2)';
        ctx.lineWidth = sel ? 2 : 1;
        if (fpElShape(el) === 'poly') {
          fpRoundPolyPath(ctx, el.points, fpElementCornerRadius(el));
          ctx.fill(); ctx.stroke();
          if (sel) {
            ctx.fillStyle = '#59b300';
            el.points.forEach((pt, pi) => {
              const active = pi === FP.vertexDrag || pi === FP.polyVertexIdx;
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, active ? 7 : 4, 0, Math.PI * 2);
              ctx.fill();
              ctx.strokeStyle = '#fff';
              ctx.lineWidth = active ? 2 : 1;
              ctx.stroke();
            });
          }
          const label = fpRoomCanvasLabel(el);
          const c = fpFindElementLabelPosition(ctx, el, label, 12, placedLabelBoxes, fpCollectLabelBlockers(el, 'room'));
          if (c.ok) {
            placedLabelBoxes.push(c.box);
            ctx.fillStyle = 'rgba(255,255,255,0.7)';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(label, c.x, c.y);
          }
        } else {
          fpRectPath(ctx, el.x, el.y, el.w, el.h, fpElementCornerRadius(el));
          ctx.fill();
          ctx.stroke();
          const label = fpRoomCanvasLabel(el);
          const c = fpFindElementLabelPosition(ctx, el, label, 12, placedLabelBoxes, fpCollectLabelBlockers(el, 'room'));
          if (c.ok) {
            placedLabelBoxes.push(c.box);
            ctx.fillStyle = 'rgba(255,255,255,0.7)';
            ctx.font = '12px sans-serif';
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillText(label, c.x, c.y);
          }
        }
        break;
      case 'room-label':
        ctx.fillStyle = sel ? 'rgba(89,179,0,0.15)' : 'rgba(255,255,255,0.06)';
        ctx.font = (el.fontSize || 14) + 'px sans-serif';
        const tw = ctx.measureText(el.text).width + 20;
        fpRectPath(ctx, el.x - tw/2, el.y - 14, tw, 28, fpElementCornerRadius(el));
        ctx.fill();
        placedLabelBoxes.push({ x1: el.x - tw/2, y1: el.y - 14, x2: el.x + tw/2, y2: el.y + 14 });
        ctx.fillStyle = sel ? '#59b300' : 'rgba(255,255,255,0.5)';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillText(el.text, el.x, el.y);
        break;
      case 'device':
        fpDrawDeviceMarker(ctx, el, sel);
        break;
    }
    ctx.restore();
  });
  if (FP.polyPoints?.length) {
    ctx.strokeStyle = '#59b300';
    ctx.lineWidth = 2;
    ctx.setLineDash([4, 4]);
    fpDrawPolyPath(ctx, FP.polyPoints, false);
    if (FP._polyCurr) ctx.lineTo(FP._polyCurr.x, FP._polyCurr.y);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#59b300';
    FP.polyPoints.forEach((pt, i) => {
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, i === 0 ? 5 : 3, 0, Math.PI * 2);
      ctx.fill();
    });
  }
  if (FP.drawing) {
    const x1 = FP.sX, y1 = FP.sY, x2 = FP.currX ?? x1, y2 = FP.currY ?? y1;
    ctx.strokeStyle = '#59b300';
    ctx.lineWidth = 2;
    ctx.setLineDash([4, 4]);
    if (FP.tool === 'room' || FP.tool === 'floor') {
      const rx = Math.min(x1, x2), ry = Math.min(y1, y2);
      ctx.strokeRect(rx, ry, Math.abs(x2 - x1), Math.abs(y2 - y1));
      ctx.fillStyle = 'rgba(89,179,0,0.08)';
      ctx.fillRect(rx, ry, Math.abs(x2 - x1), Math.abs(y2 - y1));
    } else {
      ctx.beginPath();
      ctx.moveTo(x1, y1);
      ctx.lineTo(x2, y2);
      ctx.stroke();
    }
    ctx.setLineDash([]);
  }
  if (FP.boxSelect?.active) {
    const x1 = Math.min(FP.boxSelect.x1, FP.boxSelect.x2);
    const y1 = Math.min(FP.boxSelect.y1, FP.boxSelect.y2);
    const rw = Math.abs(FP.boxSelect.x2 - FP.boxSelect.x1);
    const rh = Math.abs(FP.boxSelect.y2 - FP.boxSelect.y1);
    ctx.fillStyle = 'rgba(89,179,0,0.1)';
    ctx.strokeStyle = '#59b300';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([5, 4]);
    ctx.fillRect(x1, y1, rw, rh);
    ctx.strokeRect(x1, y1, rw, rh);
    ctx.setLineDash([]);
  }
  ctx.restore();
}

function fpRoundRect(ctx, x, y, w, h, r) {
  r = Math.max(0, Math.min(r || 0, Math.abs(w) / 2, Math.abs(h) / 2));
  if (!r) {
    ctx.beginPath();
    ctx.rect(x, y, w, h);
    ctx.closePath();
    return;
  }
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();
}

function setupViewToggle() {
  const container = document.getElementById('viewToggle');
  if (!container) return;
  container.querySelectorAll('button').forEach(btn => {
    btn.addEventListener('click', () => {
      container.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.homeView = btn.dataset.view === 'map' ? 'map' : 'tiles';
      applyHomeViewToggle();
      switchPage('home');
    });
  });
}

if (document.readyState !== 'loading') {
  setTimeout(() => setupViewToggle(), 100);
} else {
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => setupViewToggle(), 100);
  });
}
</script>
