<script>
// ─── State ─────────────────────────────────────────────────────────────────
const CURRENT_USER_EMAIL = <?=json_encode($userEmail, JSON_UNESCAPED_UNICODE)?>;
const state = {
  devices: [],
  myDevices: [],
  groups: [],
  settings: <?=json_encode($settings, JSON_UNESCAPED_UNICODE)?>,
  floorPlan: [],
  apiDocs: '',
  selectedDevice: null,
  viewDeviceId: null,
  drawerOpen: false,
  currentPage: 'home',
  homeView: <?=json_encode(($settings['home_view'] ?? 'tiles') === 'map' ? 'map' : 'tiles')?>,
  canEditEndpoints: <?=json_encode($canEditEndpoints)?>,
  canEditMap: true,
  homeScope: <?=json_encode($settings['home_scope'] ?? 'own')?>,
  homeGroupId: <?=json_encode($settings['home_group_id'] ?? '')?>,
};
let rtPollTimer = null;
const HIDDEN_PARAM_IDS = ['firmware','ap_domain','mqtt_transport','server_domain'];
function isHiddenParam(p) {
  const id = String(p?.id||'').toLowerCase();
  const label = String(p?.label||'').toLowerCase();
  if (HIDDEN_PARAM_IDS.includes(id)) return true;
  if (label.includes('firmware') || label.includes('domain') || label.includes('transport') || label.includes('прошив') || label.includes('домен') || label.includes('транспорт')) return true;
  return false;
}
function visibleParams(device) {
  return (device.params||[]).filter(p => !isHiddenParam(p));
}
function getPreviewControls(d) {
  const all = d.controls||[];
  const ids = d.displayed_controls||[];
  if (ids.length) return all.filter(c => ids.includes(c.id));
  return all.filter(c => c.primary);
}
function renderControlsHtml(d, controls, editable) {
  let html = '';
  const groups = [];
  const groupMap = {};
  (controls || []).forEach(c => {
    const sid = c.section || 'controls';
    if (!groupMap[sid]) {
      groupMap[sid] = { id: sid, label: c.section_label || (sid === 'controls' ? uiText.controls : sid), controls: [] };
      groups.push(groupMap[sid]);
    }
    groupMap[sid].controls.push(c);
  });
  groups.forEach(g => {
    if (groups.length > 1) html += `<section class="device-control-section"><h3>${esc(g.label)}</h3>`;
    g.controls.forEach(c => {
    html += '<div class="control-group">';
    if (c.type === 'switch') {
      html += `<label>${esc(c.label)}</label><input type="checkbox" class="toggle-switch" ${c.value?'checked':''} data-device="${esc(d.id)}" data-control="${esc(c.id)}" onchange="handleToggle(this)" ${editable?'':'disabled'}>`;
    } else if (c.type === 'range') {
      html += `<label>${esc(c.label)}</label><div class="range-wrap"><input type="range" min="${c.min||0}" max="${c.max||100}" step="${c.step||1}" value="${c.value}" data-device="${esc(d.id)}" data-control="${esc(c.id)}" oninput="this.nextElementSibling.textContent=this.value" onchange="handleRange(this)" ${editable?'':'disabled'}><span class="range-val">${c.value}</span></div>`;
    } else if (c.type === 'color') {
      html += `<label>${esc(c.label)}</label><input type="color" value="${esc(c.value || '#ffffff')}" data-device="${esc(d.id)}" data-control="${esc(c.id)}" oninput="handleColorPreview(this)" onchange="handleColor(this)" ${editable?'':'disabled'}>`;
    } else if (c.type === 'select') {
      const opts = (c.options||[]).map(o => {
        const val = typeof o === 'object' ? String(o.value ?? '') : String(o);
        const label = typeof o === 'object' ? String(o.label ?? val) : String(o);
        return `<option value="${esc(val)}" ${String(val)===String(c.value)?'selected':''}>${esc(label)}</option>`;
      }).join('');
      html += `<label>${esc(c.label)}</label><select data-device="${esc(d.id)}" data-control="${esc(c.id)}" onchange="handleSelect(this)" style="width:100%;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface-2);color:var(--text)" ${editable?'':'disabled'}>${opts}</select>`;
    }
    html += '</div>';
  });
    if (groups.length > 1) html += '</section>';
  });
  return html;
}
const uiText = <?=json_encode($t, JSON_UNESCAPED_UNICODE)?>;
const availableIcons = <?=json_encode($availableIcons)?>;
const availableTypes = <?=json_encode($availableTypes)?>;
const typeNames = <?=json_encode($typeNames)?>;

// ─── Utils ─────────────────────────────────────────────────────────────────
function esc(v) { return String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function escJs(v) { return String(v??'').replace(/\\/g,'\\\\').replace(/'/g,"\\'").replace(/\r/g,'').replace(/\n/g,'\\n'); }

function api(action, payload={}) {
  const url = new URL(window.location.href);
  url.searchParams.set('api', action);
  return fetch(url.toString(), { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
    .then(r=>r.json()).then(d=>{ if(!d.ok) throw new Error(d.error||'Failed'); return d; });
}

function closeDrawer() {
  state.drawerOpen = false;
  document.getElementById('drawer').classList.remove('open');
  document.getElementById('drawerOverlay').classList.remove('open');
}

function toggleDrawer() {
  state.drawerOpen = !state.drawerOpen;
  document.getElementById('drawer').classList.toggle('open', state.drawerOpen);
  document.getElementById('drawerOverlay').classList.toggle('open', state.drawerOpen);
}

function setPageScrollLocked(lock) {
  document.documentElement.classList.toggle('modal-open', lock);
  document.body.classList.toggle('modal-open', lock);
}
function openModal(html, opts = {}) {
  const overlay = document.getElementById('modalOverlay');
  const mc = document.getElementById('modalContent');
  const apiDocs = !!opts.apiDocs;
  if (mc) {
    mc.classList.toggle('modal--dialog', !apiDocs && html.includes('ui-dialog'));
    mc.classList.toggle('modal--api-docs', apiDocs);
  }
  overlay?.classList.toggle('modal-overlay--api-docs', apiDocs);
  document.getElementById('modalBody').innerHTML = html;
  overlay?.classList.add('open');
  setPageScrollLocked(true);
}

function closeModal() {
  const overlay = document.getElementById('modalOverlay');
  overlay?.classList.remove('open', 'modal-overlay--api-docs');
  const mc = document.getElementById('modalContent');
  mc?.classList.remove('modal--dialog', 'modal--api-docs');
  if (!overlay?.classList.contains('open')) setPageScrollLocked(false);
  state.viewDeviceId = null;
}

const UI_ICONS = {
  alert: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>',
  danger: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>',
  confirm: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>',
};
function uiDialogHtml(kind, title, body, actions) {
  document.getElementById('modalContent')?.classList.add('modal--dialog');
  return `<div class="ui-dialog">
    <div class="ui-dialog-icon ${kind}">${UI_ICONS[kind] || UI_ICONS.confirm}</div>
    <h2 class="ui-dialog-title">${esc(title)}</h2>
    <p class="ui-dialog-body">${body}</p>
    <div class="ui-dialog-actions">${actions}</div>
  </div>`;
}
function uiAlert(msg, title) {
  openModal(uiDialogHtml('alert', title || uiText.error_title, esc(msg),
    `<button type="button" class="btn btn-primary" onclick="closeModal()">${esc(uiText.ok)}</button>`));
}
function uiConfirm(msg, onOk, title, opts = {}) {
  const danger = !!opts.danger;
  openModal(uiDialogHtml(danger ? 'danger' : 'confirm', title || uiText.confirm_title, esc(msg),
    `<button type="button" class="btn btn-secondary" onclick="closeModal()">${esc(uiText.cancel)}</button>
     <button type="button" class="btn ${danger ? 'btn-danger' : 'btn-primary'}" id="uiConfirmOk">${esc(opts.okLabel || uiText.ok)}</button>`));
  document.getElementById('uiConfirmOk')?.addEventListener('click', () => { closeModal(); onOk?.(); });
}
function uiPrompt(label, onOk, title, defVal = '') {
  openModal(uiDialogHtml('confirm', title || uiText.confirm_title,
    `<div class="ui-dialog-prompt"><label>${esc(label)}</label><input type="text" id="uiPromptInput" value="${esc(defVal)}"></div>`,
    `<button type="button" class="btn btn-secondary" onclick="closeModal()">${esc(uiText.cancel)}</button>
     <button type="button" class="btn btn-primary" id="uiPromptOk">${esc(uiText.ok)}</button>`));
  const inp = document.getElementById('uiPromptInput');
  inp?.focus();
  inp?.select();
  const submit = () => { const v = inp?.value?.trim() ?? ''; closeModal(); onOk?.(v); };
  document.getElementById('uiPromptOk')?.addEventListener('click', submit);
  inp?.addEventListener('keydown', e => { if (e.key === 'Enter') submit(); });
}
function uiToast(msg) {
  let t = document.getElementById('uiToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'uiToast';
    t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);padding:12px 20px;background:var(--surface-3);border:1px solid var(--line);border-radius:12px;z-index:400;opacity:0;transition:opacity .25s';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.style.opacity = '1';
  clearTimeout(uiToast._tm);
  uiToast._tm = setTimeout(() => { t.style.opacity = '0'; }, 2000);
}

function getIconSvg(name) {
  const icons = {
    'smart-device':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="4" width="18" height="12" rx="3"/><path d="M9 20h6"/><path d="M12 16v4"/><circle cx="12" cy="10" r="2.2"/></svg>',
    'light-bulb':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M8.8 14.5c-1.15-1.02-1.8-2.36-1.8-4.1a5 5 0 1 1 10 0c0 1.73-.65 3.08-1.8 4.1-.52.47-.86 1.07-1 1.75H9.8c-.14-.68-.48-1.28-1-1.75Z"/></svg>',
    'torch':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M8 3h8l1.6 4.5H6.4L8 3Z"/><path d="M7 7.5h10v2H7z"/><path d="M9 9.5v8a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-8"/><path d="M12 13.5v3"/><path d="M10.5 15h3"/></svg>',
    'lamp':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M7.5 10.5h9L15 6H9l-1.5 4.5Z"/><path d="M12 3.5V6"/><path d="M12 10.5V18"/><path d="M9 20h6"/></svg>',
    'smart-plug':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M9 3v4"/><path d="M15 3v4"/><path d="M7 9h10v3a5 5 0 0 1-10 0V9Z"/><path d="M12 17v4"/><path d="M9.5 21h5"/></svg>',
    'sensor':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 5a7 7 0 1 1-7 7"/><path d="M12 9a3 3 0 1 1-3 3"/><circle cx="12" cy="12" r="1.3"/><path d="M19 5 5 19"/></svg>',
    'climate':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 2.5v19"/><path d="M12 7a2.5 2.5 0 1 0 2.5 2.5V17a3.5 3.5 0 1 1-5 0"/><path d="M12 14.5V17"/></svg>',
    'fan':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><circle cx="12" cy="12" r="1.8"/><path d="M12.7 4.5c2.2 0 3.8 2.3 2.9 4.2L14.2 11"/><path d="M19.1 14c1.1 1.9-.4 4.8-2.7 4.8h-2.8"/><path d="M8.8 18.8c-1.1 1.9-4.4 2-5.5.1l-1.3-2.4"/><path d="M4.9 10.2C3.8 8.3 5.3 5.4 7.6 5.4h2.8"/></svg>',
    'kettle':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M5 12a7 7 0 0 1 14 0v2a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4v-2Z"/><path d="M19 12h1.5a2 2 0 0 0 0-4H18"/><path d="M9 18v2"/><path d="M12 18v2"/><path d="M15 18v2"/><path d="M9 6.2c0-1 .5-1.8 1.2-2.5"/><path d="M14.8 6.2c0-1-.5-1.8-1.2-2.5"/></svg>',
    'security':'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3 5 6.5v5.6c0 4.5 2.9 8.6 7 9.9 4.1-1.3 7-5.4 7-9.9V6.5L12 3Z"/><path d="M12 9.2a1.8 1.8 0 1 0 0 3.6"/><path d="M12 12.8v3.5"/></svg>',
  };
  return icons[name] || icons['smart-device'];
}

function mergeDevice(device) {
  if (!device?.id) return;
  const prev = state.devices.find(d => d.id === device.id);
  state.devices = state.devices.map(d => d.id === device.id ? { ...d, ...device } : d);
  const next = state.devices.find(d => d.id === device.id);
  if (prev && next) patchDevicesFromState([prev], [next]);
  else if (next) patchDeviceUI(next.id);
}

function setDeviceControlValue(deviceId, controlId, value) {
  const d = state.devices.find(x => x.id === deviceId);
  if (!d) return false;
  let found = false;
  d.controls = (d.controls || []).map(c => {
    if (c.id !== controlId) return c;
    found = true;
    const copy = { ...c };
    if (c.type === 'switch') copy.value = !!value;
    else if (c.type === 'range') copy.value = parseInt(value, 10);
    else copy.value = String(value);
    return copy;
  });
  return found;
}

function cloneControls(controls) {
  return JSON.parse(JSON.stringify(controls || []));
}

function fpOnDevicesUpdated() {
  if (!FP.canvas) return;
  fpRender();
  if (!fpIsViewOnly()) { fpRebuildDeviceChips(); return; }
  const idx = FP.propsIdx >= 0 ? FP.propsIdx : FP.selected;
  if (idx >= 0 && FP.elements[idx]?.type === 'device') {
    fpRenderViewSidebar(idx);
    if (fpIsMapMobile()) {
      const dev = fpGetDevice(FP.elements[idx].deviceId);
      if (dev && document.getElementById('mapDevicePopup')?.classList.contains('active')) fpOpenDevicePopup(dev);
    }
  }
}
function patchDeviceUI(deviceId) {
  const d = state.devices.find(x => x.id === deviceId);
  if (!d) return;
  updateDeviceCard(d);
  updateOpenModalDevice();
  if (FP.canvas) fpOnDevicesUpdated();
}

async function sendDeviceControl(deviceId, controlId, value, opts = {}) {
  const optimistic = opts.optimistic !== false;
  const prevControls = optimistic ? cloneControls(state.devices.find(x => x.id === deviceId)?.controls) : null;
  if (optimistic) {
    setDeviceControlValue(deviceId, controlId, value);
    patchDeviceUI(deviceId);
  }
  try {
    const data = await api('control', { device_id: deviceId, control_id: controlId, value });
    if (data.device) {
      mergeDevice(data.device);
    }
    return data;
  } catch (e) {
    if (prevControls) {
      const d = state.devices.find(x => x.id === deviceId);
      if (d) { d.controls = prevControls; patchDeviceUI(deviceId); }
    }
    throw e;
  }
}

// ─── Render Home ────────────────────────────────────────────────────────────
function deviceCardEl(id) {
  return document.querySelector('.device-card[data-id="' + String(id).replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"]');
}

function deviceControlsKey(d) {
  return JSON.stringify(getPreviewControls(d).map(c => ({ id: c.id, v: c.value })));
}

function deviceParamsKey(d) {
  const vis = visibleParams(d);
  const params = (d.displayed_params?.length ? d.displayed_params.filter(p => !isHiddenParam(p)) : vis).slice(0, 3);
  return JSON.stringify(params.map(p => ({ id: p.id, v: p.value })));
}

function devicesLayoutKey(devices) {
  const rooms = {};
  devices.forEach(d => {
    const room = d.room || 'Home';
    if (!rooms[room]) rooms[room] = [];
    rooms[room].push(d.id);
  });
  return JSON.stringify(rooms);
}

function renderCardHeadInner(d) {
  return `<div class="device-icon-box">${getIconSvg(d.icon||'smart-device')}</div>
    <div style="display:flex;align-items:center;gap:8px">
      <span class="status-label">${esc(d.status||'unknown')}</span>
      <div class="status-dot-sm ${d.status||'unknown'}"></div>
    </div>`;
}

function renderCardMetaInner(d) {
  return `<div class="card-title">${esc(d.name)}</div><div class="card-subtitle">${esc(typeNames[d.type]||d.type)}</div>`;
}

function renderCardParamsInner(d) {
  const vis = visibleParams(d);
  const params = (d.displayed_params?.length ? d.displayed_params.filter(p => !isHiddenParam(p)) : vis).slice(0, 3);
  if (!params.length) return '';
  return params.map(p => `<span class="param-chip">${esc(p.label||'')}: <span class="val">${esc(p.value||'')}</span></span>`).join('');
}

function renderCardControlsInner(d) {
  const previewCtrls = getPreviewControls(d);
  if (!previewCtrls.length) return '';
  return previewCtrls.map(c => {
    if (c.type === 'switch') {
      const on = asSwitchVal(c.value);
      return `<span class="card-control-chip ${on?'on':''}" onclick="event.stopPropagation();quickToggle('${esc(d.id)}','${esc(c.id)}')">${esc(c.label||c.id)}: ${on ? 'ON' : 'OFF'}</span>`;
    }
    if (c.type === 'range') {
      return `<span class="card-control-chip">${esc(c.label||c.id)}: ${esc(String(c.value))}</span>`;
    }
    return '';
  }).join('');
}

function buildDeviceCardHtml(d, room) {
  const params = renderCardParamsInner(d);
  const ctrls = renderCardControlsInner(d);
  return `<div class="device-card" data-id="${esc(d.id)}">
    <div class="device-card-head" data-part="head">${renderCardHeadInner(d)}</div>
    <div class="device-card-meta" data-part="meta">${renderCardMetaInner(d)}</div>
    ${params ? `<div class="card-params" data-part="params">${params}</div>` : '<div class="card-params" data-part="params" style="display:none"></div>'}
    ${ctrls ? `<div class="card-controls" data-part="controls">${ctrls}</div>` : '<div class="card-controls" data-part="controls" style="display:none"></div>'}
    <div class="card-footer" data-part="footer"><div class="card-open">${esc(room)}</div></div>
  </div>`;
}

function updateDeviceCard(d, prev) {
  const card = deviceCardEl(d.id);
  if (!card) return false;
  const p = prev || {};
  if ((p.status||'') !== (d.status||'') || (p.icon||'') !== (d.icon||'')) {
    const el = card.querySelector('[data-part="head"]');
    if (el) el.innerHTML = renderCardHeadInner(d);
  }
  if ((p.name||'') !== (d.name||'') || (p.type||'') !== (d.type||'')) {
    const el = card.querySelector('[data-part="meta"]');
    if (el) el.innerHTML = renderCardMetaInner(d);
  }
  if (deviceParamsKey(p) !== deviceParamsKey(d)) {
    const el = card.querySelector('[data-part="params"]');
    const html = renderCardParamsInner(d);
    if (el) { el.innerHTML = html; el.style.display = html ? '' : 'none'; }
  }
  if (deviceControlsKey(p) !== deviceControlsKey(d)) {
    const el = card.querySelector('[data-part="controls"]');
    const html = renderCardControlsInner(d);
    if (el) { el.innerHTML = html; el.style.display = html ? '' : 'none'; }
  }
  if ((p.room||'Home') !== (d.room||'Home')) {
    const el = card.querySelector('[data-part="footer"] .card-open');
    if (el) el.textContent = d.room || 'Home';
  }
  return true;
}

function removeDeviceCard(id) {
  deviceCardEl(id)?.remove();
  const container = document.getElementById('roomsContainer');
  if (container && !container.querySelector('.device-card')) {
    document.getElementById('homeEmptyState').style.display = 'block';
  }
}
function applyDevicesFromApi(data) {
  const prev = JSON.parse(JSON.stringify(state.devices));
  if (data.devices) state.devices = data.devices;
  if (data.my_devices) state.myDevices = data.my_devices;
  patchDevicesFromState(prev, state.devices);
  if (state.currentPage === 'devices') renderDevicesTable();
  if (FP.canvas) { fpRebuildDeviceChips(); fpRender(); if (fpIsViewOnly()) fpRenderProps(); }
}
function removeDeviceFromState(id) {
  const prev = JSON.parse(JSON.stringify(state.devices));
  state.devices = state.devices.filter(d => d.id !== id);
  state.myDevices = state.myDevices.filter(d => d.id !== id);
  if (FP.elements?.length) {
    const had = FP.elements.some(e => e.type === 'device' && e.deviceId === id);
    FP.elements = FP.elements.filter(e => !(e.type === 'device' && e.deviceId === id));
    if (FP.selected >= 0 && FP.elements[FP.selected]?.deviceId === id) { FP.selected = -1; FP.propsIdx = -1; }
    if (had) fpCloseDevicePopup();
  }
  patchDevicesFromState(prev, state.devices);
  if (state.currentPage === 'devices') renderDevicesTable();
  if (FP.canvas) { fpRebuildDeviceChips(); fpRender(); }
}

function renderHomeStats() {
  let total = 0, on = 0, off = 0, unk = 0;
  state.devices.forEach(d => {
    total++;
    if (d.status === 'online') on++;
    else if (d.status === 'offline') off++;
    else unk++;
  });
  const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
  set('statTotal', total);
  set('statOnline', on);
  set('statOffline', off);
  set('statUnknown', unk);
  set('totalBadge', total);
}

function patchDevicesFromState(prevDevices, nextDevices) {
  const prev = prevDevices || [];
  const next = nextDevices || state.devices;
  if (devicesLayoutKey(prev) !== devicesLayoutKey(next)) {
    renderHome();
    return;
  }
  const prevIds = new Set(prev.map(d => d.id));
  const nextIds = new Set(next.map(d => d.id));
  if (prevIds.size !== nextIds.size || [...nextIds].some(id => !prevIds.has(id))) {
    renderHome();
    return;
  }
  const prevMap = Object.fromEntries(prev.map(d => [d.id, d]));
  const mapIds = new Set((FP.elements || []).filter(e => e.type === 'device').map(e => e.deviceId));
  let mapTouch = false;
  next.forEach(nd => {
    const od = prevMap[nd.id];
    if (od && deviceSnapshot(od) !== deviceSnapshot(nd)) {
      updateDeviceCard(nd, od);
      if (mapIds.has(nd.id)) mapTouch = true;
    }
  });
  if (mapTouch) fpOnDevicesUpdated();
  renderHomeStats();
}

function renderHome() {
  const container = document.getElementById('roomsContainer');
  const empty = document.getElementById('homeEmptyState');
  if (!state.devices.length) {
    container.innerHTML = '';
    empty.style.display = 'block';
    renderHomeStats();
    return;
  }
  empty.style.display = 'none';
  const rooms = {};
  state.devices.forEach(d => {
    const room = d.room || 'Home';
    if (!rooms[room]) rooms[room] = [];
    rooms[room].push(d);
  });
  let html = '';
  Object.entries(rooms).forEach(([room, devices]) => {
    html += `<div class="room-section" data-room="${esc(room)}">
      <div class="room-header"><h2>${esc(room)}</h2><span class="count">${devices.length}</span></div>
      <div class="device-grid">`;
    devices.forEach(d => { html += buildDeviceCardHtml(d, room); });
    html += '</div></div>';
  });
  container.innerHTML = html;
  renderHomeStats();
}

function deviceSnapshot(d) {
  return JSON.stringify({ controls: d.controls, params: d.params, files: d.files, status: d.status, name: d.name, room: d.room, icon: d.icon, type: d.type, displayed_controls: d.displayed_controls, displayed_params: d.displayed_params });
}

function devicesStateChanged(prev, next) {
  if (prev.length !== next.length) return true;
  for (const nd of next) {
    const od = prev.find(x => x.id === nd.id);
    if (!od || deviceSnapshot(od) !== deviceSnapshot(nd)) return true;
  }
  return false;
}

function startRealtimeSync() {
  if (rtPollTimer) return;
  rtPollTimer = setInterval(() => {
    if (document.hidden) return;
    const prev = JSON.parse(JSON.stringify(state.devices));
    api('state').then(data => {
      const next = data.devices || [];
      state.myDevices = data.my_devices || next;
      state.canEditMap = data.can_edit_map !== false;
      if (!devicesStateChanged(prev, next)) return;
      state.devices = next;
    state.settings = data.settings || state.settings;
    state.floorPlan = data.floor_plan || state.floorPlan;
    if (Array.isArray(state.floorPlan)) state.floorPlan = state.floorPlan.map(el => fpNormalizeElement(el));
    patchDevicesFromState(prev, next);
      updateOpenModalDevice();
      if (FP.canvas && FP.elements.some(e => e.type === 'device')) fpOnDevicesUpdated();
      else if (FP.canvas) fpRebuildDeviceChips();
      if (state.currentPage === 'statistics') renderStatistics();
      if (state.currentPage === 'devices') renderDevicesTable();
    }).catch(() => {});
  }, 8000);
}

function renderModalMeta(d) {
  return `<span class="detail-badge"><span class="status-dot ${d.status||'unknown'}"></span>${esc(d.status||'unknown')}</span>
    <span class="detail-badge">${esc(d.room||'Home')}</span>
    <span class="detail-badge">${esc(typeNames[d.type]||d.type)}</span>`;
}

function renderModalParamsHtml(d) {
  const params = visibleParams(d);
  if (!params.length) return '';
  const groups = [];
  const groupMap = {};
  params.forEach(p => {
    const sid = p.section || 'params';
    if (!groupMap[sid]) {
      groupMap[sid] = { id: sid, label: p.section_label || (sid === 'params' ? uiText.params : sid), params: [] };
      groups.push(groupMap[sid]);
    }
    groupMap[sid].params.push(p);
  });
  let html = '';
  groups.forEach(g => {
    html += `<section class="device-control-section"><h3>${esc(g.label)}</h3><div class="detail-grid">`;
    g.params.forEach(p => {
      html += `<div class="detail-param-card"><div class="label">${esc(p.label||'')}</div><div class="value">${esc(p.value||'')}</div></div>`;
    });
    html += '</div></section>';
  });
  return html;
}

function deviceFileUrl(d, f) {
  const raw = String(f?.url || f?.href || '');
  if (!raw) return '';
  if (/^https?:\/\//i.test(raw)) return raw;
  const base = String(d?.local_url || '').replace(/\/+$/, '');
  if (!base) return raw;
  return base + (raw.startsWith('/') ? raw : '/' + raw);
}

function renderModalFilesHtml(d) {
  const files = d.files || [];
  if (!files.length) return '';
  let html = `<section class="device-control-section"><h3>${esc(uiText.files || 'Files')}</h3><div class="detail-grid">`;
  files.forEach(f => {
    const label = f.label || f.id || f.url || '';
    const url = deviceFileUrl(d, f);
    if (url) {
      html += `<a class="detail-param-card" href="${esc(url)}" target="_blank" rel="noopener"><div class="label">${esc(label)}</div><div class="value">${esc(f.kind || 'link')}</div></a>`;
    } else {
      html += `<div class="detail-param-card"><div class="label">${esc(label)}</div><div class="value">${esc(f.kind || '')}</div></div>`;
    }
  });
  html += '</div></section>';
  return html;
}

function showDeviceView(deviceId) {
  const d = state.devices.find(x => x.id === deviceId);
  if (!d) return;
  state.viewDeviceId = deviceId;
  const controls = d.controls||[];
  let html = `<h2 class="modal-title">${esc(d.name)}</h2>
  <div class="detail-meta" id="modalMetaHost">${renderModalMeta(d)}</div>`;
  if (controls.length) {
    html += `<h3 class="modal-title" style="font-size:15px;margin-top:12px">${esc(uiText.controls)}</h3>
      <div id="modalControlsHost">${renderControlsHtml(d, controls, true)}</div>`;
  }
  html += `<div id="modalParamsHost">${renderModalParamsHtml(d)}</div>`;
  html += `<div id="modalFilesHost">${renderModalFilesHtml(d)}</div>`;
  if (deviceCanConfigure(d)) {
    html += `<div style="margin-top:16px"><button type="button" class="btn btn-secondary" onclick="showDeviceSettings('${esc(d.id)}')">${esc(uiText.edit)}</button></div>`;
  }
  openModal(html);
}

function updateOpenModalDevice() {
  if (!state.viewDeviceId || !document.getElementById('modalOverlay')?.classList.contains('open')) return;
  const d = state.devices.find(x => x.id === state.viewDeviceId);
  if (!d) return;
  const meta = document.getElementById('modalMetaHost');
  if (meta) meta.innerHTML = renderModalMeta(d);
  const ch = document.getElementById('modalControlsHost');
  if (ch) ch.innerHTML = renderControlsHtml(d, d.controls||[], true);
  const ph = document.getElementById('modalParamsHost');
  if (ph) ph.innerHTML = renderModalParamsHtml(d);
  const fh = document.getElementById('modalFilesHost');
  if (fh) fh.innerHTML = renderModalFilesHtml(d);
}

function showDeviceSettings(deviceId) {
  const d = (state.myDevices.length ? state.myDevices : state.devices).find(x => x.id === deviceId) || fpGetDevice(deviceId);
  if (!d || !deviceCanConfigure(d)) return;
  const manageGroups = state.groups.filter(g => g.can_manage);
  const groupOpts = `<option value="">${esc('—')}</option>` + manageGroups.map(g =>
    `<option value="${esc(g.id)}" ${(d.group_id||'')===g.id?'selected':''}>${esc(g.name)}</option>`).join('');
  const params = d.params||[];
  const displayedParams = d.displayed_params||[];
  const displayedControls = d.displayed_controls||[];
  let html = `<h2 class="modal-title">${esc(uiText.device_settings)}: ${esc(d.name)}</h2>
  <div class="form-row">
    <div class="form-group"><label>${esc(uiText.device_name)}</label><input type="text" id="editName" value="${esc(d.name)}"></div>
    <div class="form-group"><label>${esc(uiText.device_category)}</label><input type="text" id="editCategory" value="${esc(d.category||'')}" list="editCategoryList"></div>
  </div>
  <datalist id="editCategoryList">${getDeviceCategories().map(c => `<option value="${esc(c)}">`).join('')}</datalist>
  <div class="form-group"><label>${esc(uiText.room)}</label><input type="text" id="editRoom" value="${esc(d.room||'')}"></div>
  ${manageGroups.length ? `<div class="form-group"><label>${esc(uiText.device_group_label)}</label><select id="editGroupId">${groupOpts}</select></div>` : ''}
  <div class="form-group"><label>${esc(uiText.mqtt_topic)}</label><input type="text" id="editMqtt" value="${esc(d.mqtt_topic||'')}"></div>
  <div class="form-group"><label>${esc(uiText.local_url)}</label><input type="text" id="editLocalUrl" value="${esc(d.local_url||'')}" readonly placeholder="${esc(uiText.add_device_token_hint)}"></div>
  <div class="form-group"><label>${esc(uiText.device_token)}</label><input type="text" id="editToken" value="${esc(d.device_token||'')}"></div>
  <div class="form-group"><label>${esc(uiText.notes)}</label><textarea id="editNotes">${esc(d.notes||'')}</textarea></div>
  <h3 class="modal-title" style="font-size:15px">${esc(uiText.choose_controls)}</h3>
  <div class="param-selector">`;
  (d.controls||[]).forEach(c => {
    const checked = displayedControls.includes(c.id) || (!displayedControls.length && c.primary);
    html += `<label><input type="checkbox" class="disp-ctrl" value="${esc(c.id)}" ${checked?'checked':''}> ${esc(c.label||c.id)}</label>`;
  });
  html += `</div><h3 class="modal-title" style="font-size:15px;margin-top:12px">${esc(uiText.choose_params)}</h3><div class="param-selector">`;
  params.forEach(p => {
    const checked = displayedParams.some(dp => dp.id === p.id) || displayedParams.length === 0;
    html += `<label><input type="checkbox" class="disp-param" value="${esc(p.id)}" ${checked?'checked':''}> ${esc(p.label||p.id)}</label>`;
  });
  html += `</div><div class="form-group"><label>${esc(uiText.icon)}</label><div class="icon-picker">`;
  availableIcons.forEach(ic => {
    html += `<label class="icon-choice ${ic===d.icon?'active':''}"><input type="radio" name="iconSelect" value="${ic}" ${ic===d.icon?'checked':''} style="display:none" onchange="document.querySelectorAll('.icon-choice').forEach(el=>el.classList.remove('active'));this.closest('.icon-choice').classList.add('active')">${getIconSvg(ic)}<span>${esc(ic.replace(/-/g,' '))}</span></label>`;
  });
  html += `</div></div><div style="display:flex;gap:8px;margin-top:16px;flex-wrap:wrap">
    <button class="btn btn-primary" onclick="saveDeviceFromDetail('${esc(d.id)}')">${esc(uiText.save)}</button>
    <button class="btn btn-danger" onclick="deleteDeviceFromDetail('${esc(d.id)}')">${esc(uiText.delete_device)}</button>
  </div>`;
  openModal(html);
}

function updateDisplayedParams(deviceId) {
  const d = state.devices.find(x => x.id === deviceId);
  if (!d) return;
  const checks = document.querySelectorAll('.param-selector input[type=checkbox]');
  const selectedParams = [];
  checks.forEach(c => {
    if (c.checked) {
      const param = (d.params||[]).find(p => p.id === c.value);
      if (param) selectedParams.push(param);
    }
  });
  api('update_displayed_params', { device_id: deviceId, displayed_params: selectedParams });
}

function saveDeviceFromDetail(id) {
  const d = (state.myDevices.length ? state.myDevices : state.devices).find(x => x.id === id);
  const iconRadio = document.querySelector('input[name="iconSelect"]:checked');
  const dispCtrl = [...document.querySelectorAll('.disp-ctrl:checked')].map(c => c.value);
  const dispParamIds = [...document.querySelectorAll('.disp-param:checked')].map(c => c.value);
  const selectedParams = (d.params||[]).filter(p => dispParamIds.includes(p.id));
  const payload = {
    id,
    name: document.getElementById('editName')?.value.trim() || d.name,
    category: document.getElementById('editCategory')?.value.trim() || '',
    room: document.getElementById('editRoom')?.value.trim() || d.room,
    type: d.type,
    local_url: d.local_url || '',
    server_domain: d.server_domain,
    ap_domain: d.ap_domain,
    mqtt_topic: document.getElementById('editMqtt')?.value || d.mqtt_topic,
    device_token: document.getElementById('editToken')?.value || d.device_token,
    notes: document.getElementById('editNotes')?.value || d.notes,
    icon: iconRadio ? iconRadio.value : d.icon,
    status: d.status,
  };
  const gidEl = document.getElementById('editGroupId');
  if (gidEl) payload.group_id = gidEl.value || '';
  Promise.all([
    api('save_device', payload),
    api('update_displayed_controls', { device_id: id, displayed_controls: dispCtrl }),
    api('update_displayed_params', { device_id: id, displayed_params: selectedParams }),
  ]).then(([data]) => {
    if (data.devices) state.devices = data.devices;
    if (data.my_devices) state.myDevices = data.my_devices;
    const dev = (state.myDevices.length ? state.myDevices : state.devices).find(x => x.id === id);
    if (dev) { dev.displayed_controls = dispCtrl; dev.displayed_params = selectedParams; }
    closeModal();
    applyDevicesFromApi(data);
  }).catch(e => uiAlert(e.message));
}

function deleteDeviceFromDetail(id) {
  uiConfirm(uiText.confirm_delete, () => {
    api('delete_device', { device_id: id }).then(data => {
      closeModal();
      if (data.devices) applyDevicesFromApi(data);
      else removeDeviceFromState(id);
    }).catch(e => uiAlert(e.message));
  }, null, { danger: true, okLabel: uiText.delete_device });
}

function confirmDeleteDevice(id) {
  uiConfirm(uiText.confirm_delete, () => {
    api('delete_device', { device_id: id }).then(data => {
      if (data.devices) applyDevicesFromApi(data);
      else removeDeviceFromState(id);
    }).catch(e => uiAlert(e.message));
  }, null, { danger: true, okLabel: uiText.delete_device });
}

function confirmDeleteGroup(groupId) {
  uiConfirm(uiText.confirm_delete_group, () => {
    api('delete_group', { group_id: groupId }).then(() => loadState()).catch(e => uiAlert(e.message));
  }, null, { danger: true, okLabel: uiText.delete_device });
}

function confirmRemoveMember(groupId, memberEmail, groupName) {
  uiConfirm(uiText.confirm_remove_member, () => {
    api('remove_member', { group_id: groupId, member_email: memberEmail })
      .then(() => loadGroupMembers(groupId, groupName))
      .catch(e => uiAlert(e.message));
  }, null, { danger: true, okLabel: uiText.remove });
}

// ─── Control Handlers ──────────────────────────────────────────────────────
function handleToggle(el) {
  const deviceId = el.dataset.device;
  const controlId = el.dataset.control;
  const value = el.checked;
  sendDeviceControl(deviceId, controlId, value).catch(e => {
    el.checked = !el.checked;
    uiAlert(e.message);
  });
}

function handleRange(el) {
  const deviceId = el.dataset.device;
  const controlId = el.dataset.control;
  const value = parseInt(el.value);
  sendDeviceControl(deviceId, controlId, value).catch(e => uiAlert(e.message));
}

function handleSelect(el) {
  const deviceId = el.dataset.device;
  const controlId = el.dataset.control;
  const value = el.value;
  sendDeviceControl(deviceId, controlId, value).catch(e => uiAlert(e.message));
}

function handleColorPreview(el) {
  setDeviceControlValue(el.dataset.device, el.dataset.control, el.value);
  patchDeviceUI(el.dataset.device);
}

function handleColor(el) {
  const deviceId = el.dataset.device;
  const controlId = el.dataset.control;
  const value = el.value;
  sendDeviceControl(deviceId, controlId, value).catch(e => uiAlert(e.message));
}

function asSwitchVal(v) {
  return v === true || v === 1 || v === '1' || v === 'true';
}
function quickToggle(deviceId, controlId) {
  const d = state.devices.find(x => x.id === deviceId);
  if (!d) return;
  const c = (d.controls||[]).find(x => x.id === controlId);
  if (!c) return;
  const newVal = !asSwitchVal(c.value);
  sendDeviceControl(deviceId, controlId, newVal).catch(e => uiAlert(e.message || 'Control failed'));
}

// ─── Render Devices Table ───────────────────────────────────────────────────
function renderDevicesTable() {
  const search = (document.getElementById('deviceSearch')?.value||'').toLowerCase();
  const list = state.myDevices.length ? state.myDevices : state.devices;
  const filtered = list.filter(d => {
    if (!search) return true;
    return [d.name, d.room, d.type, d.category, d.mqtt_topic].some(v => (v||'').toLowerCase().includes(search));
  });
  const tbody = document.getElementById('deviceTableBody');
  tbody.innerHTML = filtered.map(d => `
    <tr>
      <td class="icon-cell">${getIconSvg(d.icon||'smart-device')}</td>
      <td><strong>${esc(d.name)}</strong></td>
      <td>${esc(d.category||'')}</td>
      <td>${esc(d.room||'')}</td>
      <td>${esc(typeNames[d.type]||d.type)}</td>
      <td><span class="status-dot ${d.status||'unknown'}" style="display:inline-block;vertical-align:middle;margin-right:6px"></span>${esc(d.status||'unknown')}</td>
      <td style="font-size:12px;color:var(--text-secondary)">${esc(d.mqtt_topic||'')}</td>
      <td>
        ${deviceCanConfigure(d) ? `<button class="btn btn-ghost btn-sm" onclick="showDeviceSettings('${esc(d.id)}')">${esc(uiText.edit)}</button>
        <button class="btn btn-danger btn-sm" onclick="confirmDeleteDevice('${esc(d.id)}')">${esc(uiText.delete_device)}</button>` : ''}
      </td>
    </tr>
  `).join('');
}

// ─── Render Groups ──────────────────────────────────────────────────────────
function renderGroups() {
  const container = document.getElementById('groupsContainer');
  if (!state.groups.length) {
    container.innerHTML = `<div class="empty-state"><p>${esc(uiText.no_groups||'No groups yet')}</p></div>`;
    return;
  }
  let html = '';
  state.groups.forEach(g => {
    const isOwner = g.user_email === CURRENT_USER_EMAIL;
    const seeMembers = g.can_see_members || isOwner || g.member_role === 'admin';
    html += `<div style="background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:16px;margin-bottom:12px">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <div>
          <h3 style="font-size:16px;font-weight:500">${esc(g.name)}</h3>
          <span style="font-size:12px;color:var(--text-secondary)">${esc(g.user_email)}</span>
        </div>
        <div style="display:flex;gap:8px">
          ${seeMembers ? `<button class="btn btn-secondary btn-sm" onclick="loadGroupMembers('${escJs(g.id)}','${escJs(g.name)}')">${esc(uiText.members)}</button>` : ''}
          ${isOwner ? `<button class="btn btn-danger btn-sm" onclick="confirmDeleteGroup('${escJs(g.id)}')">${esc(uiText.delete_device)}</button>` : ''}
        </div>
      </div>
    </div>`;
  });
  container.innerHTML = html;
}

function loadGroupMembers(groupId, groupName) {
  _groupModalName = groupName;
  api('group_members', { group_id: groupId }).then(data => {
    const ownerEmail = data.owner_email || '';
    const canManage = !!data.can_manage;
    let html = `<h2>${esc(groupName)}</h2>`;
    if (!canManage && !(data.members||[]).length) {
      html += `<p style="color:var(--text-secondary);font-size:14px">${esc(uiText.members_hidden)}</p>`;
      openModal(html);
      return;
    }
    if (canManage) {
      html += `<div style="margin-bottom:16px">
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <input type="email" id="newMemberEmail" placeholder="${esc(uiText.member_email)}" style="flex:1;min-width:180px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface-2);color:var(--text)">
        <select id="newMemberRole" style="padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--surface-2);color:var(--text)">
          <option value="guest">${esc(uiText.guest)}</option>
          <option value="admin">${esc(uiText.admin)}</option>
        </select>
        <button type="button" class="btn btn-primary btn-sm" id="addMemberBtn">${esc(uiText.add_member)}</button>
      </div>
    </div>`;
    }
    html += `<div id="membersList">`;
    (data.members||[]).forEach(m => {
      const isOwner = m.is_owner || m.role === 'owner' || m.member_email === ownerEmail;
      const roleLabel = isOwner ? uiText.owner : (uiText[m.role] || m.role);
      const roleClass = isOwner ? 'owner' : esc(m.role);
      html += `<div class="member-item">
        <div class="member-info">
          <div class="member-avatar">${esc((m.member_name||m.member_email||'?')[0].toUpperCase())}</div>
          <div>
            <div>${esc(m.member_name||m.member_email)}</div>
            <div style="font-size:12px;color:var(--text-secondary)">${esc(m.member_email)}</div>
          </div>
        </div>
        <div style="display:flex;gap:8px;align-items:center">
          <span class="role-badge ${roleClass}">${esc(roleLabel)}</span>
          ${canManage && !isOwner ? `<button type="button" class="btn btn-ghost btn-sm btn-remove-member" data-email="${esc(m.member_email)}">${esc(uiText.remove)}</button>` : ''}
          ${canManage && !isOwner ? `<select class="member-role-select" data-email="${esc(m.member_email)}" style="padding:4px 8px;border:1px solid var(--line);border-radius:6px;background:var(--surface-2);color:var(--text);font-size:12px">
            <option value="guest" ${m.role==='guest'?'selected':''}>${esc(uiText.guest)}</option>
            <option value="admin" ${m.role==='admin'?'selected':''}>${esc(uiText.admin)}</option>
          </select>` : ''}
        </div>
      </div>`;
    });
    html += `</div>`;
    openModal(html);
    if (canManage) {
      document.getElementById('addMemberBtn')?.addEventListener('click', () => addMember(groupId));
      document.getElementById('newMemberEmail')?.addEventListener('keydown', e => { if (e.key === 'Enter') addMember(groupId); });
      document.querySelectorAll('#modalBody .btn-remove-member').forEach(btn => {
        btn.addEventListener('click', () => confirmRemoveMember(groupId, btn.dataset.email, groupName));
      });
      document.querySelectorAll('#modalBody .member-role-select').forEach(sel => {
        sel.addEventListener('change', () => {
          api('update_member_role', { group_id: groupId, member_email: sel.dataset.email, role: sel.value })
            .then(() => loadGroupMembers(groupId, groupName))
            .catch(e => uiAlert(e.message));
        });
      });
    }
  }).catch(e => uiAlert(e.message));
}

let _groupModalName = '';
function addMember(groupId) {
  const email = document.getElementById('newMemberEmail')?.value.trim();
  const role = document.getElementById('newMemberRole')?.value || 'guest';
  if (!email) { uiAlert(uiText.member_email); return; }
  api('add_member', { group_id: groupId, member_email: email, role }).then(() => {
    loadGroupMembers(groupId, _groupModalName || document.querySelector('#modalBody h2')?.textContent || '');
  }).catch(e => uiAlert(e.message));
}

// ─── Render Statistics ──────────────────────────────────────────────────────
function renderStatistics() {
  const period = document.getElementById('statsPeriod')?.value || 24;
  api('monitor_stats', { period }).then(data => {
    // Stats cards
    const devices = data.devices||[];
    const events = data.events||[];
    let total=0, on=0, off=0, unk=0, totalEvents=0;
    devices.forEach(d => { total++; if(d.status==='online')on++; else if(d.status==='offline')off++; else unk++; });
    totalEvents = events.length;
    document.getElementById('statsCards').innerHTML = `
      <div class="stat-card"><div class="stat-value">${total}</div><div class="stat-label">${esc(uiText.devices_count)}</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--success)">${on}</div><div class="stat-label">${esc(uiText.online_count)}</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--danger)">${off}</div><div class="stat-label">${esc(uiText.offline_count)}</div></div>
      <div class="stat-card"><div class="stat-value" style="color:var(--text-secondary)">${unk}</div><div class="stat-label">${esc(uiText.unknown_count)}</div></div>
      <div class="stat-card"><div class="stat-value">${totalEvents}</div><div class="stat-label">${esc(uiText.events)}</div></div>
    `;
    // Events list
    const eventsList = document.getElementById('eventsList');
    if (!events.length) {
      eventsList.innerHTML = `<div class="empty-state" style="padding:20px"><p>No events</p></div>`;
    } else {
      eventsList.innerHTML = events.slice(0,50).map(e => `
        <div class="event-item">
          <div class="event-time">${esc(e.created_at||'')}</div>
          <div><strong>${esc(e.event_label || e.event_type || '')}</strong></div>
        </div>
      `).join('');
    }
    // Param history
    const phContainer = document.getElementById('paramHistoryContainer');
    const paramHistory = data.paramHistory||[];
    if (!paramHistory.length) {
      phContainer.innerHTML = `<div class="empty-state" style="padding:20px"><p>No param history</p></div>`;
    } else {
      // Group by param_id
      const groups = {};
      paramHistory.forEach(p => {
        if (!groups[p.param_id]) groups[p.param_id] = [];
        groups[p.param_id].push(p);
      });
      let phHtml = '';
      Object.entries(groups).slice(0,5).forEach(([pid, vals]) => {
        const label = vals[0]?.param_label || pid;
        const maxVal = Math.max(...vals.map(v => parseFloat(v.param_value) || 0), 1);
        phHtml += `<div style="margin-bottom:16px">
          <h4 style="font-size:13px;font-weight:500;margin-bottom:6px">${esc(label)} (${esc(vals[0]?.device_id||'')})</h4>
          <div class="param-chart">`;
        vals.slice(-30).forEach(v => {
          const h = Math.max(2, (parseFloat(v.param_value)||0) / maxVal * 80);
          phHtml += `<div class="bar" style="height:${h}px" title="${esc(v.param_value)} ${esc(v.recorded_at)}"></div>`;
        });
        phHtml += `</div></div>`;
      });
      phContainer.innerHTML = phHtml;
    }
  }).catch(e => console.error('Stats error:', e));
}

function renderErrors() {
  const period = document.getElementById('errorsPeriod')?.value || 168;
  api('monitor_errors', { period }).then(data => {
    const list = document.getElementById('errorsList');
    const errors = data.errors || [];
    if (!errors.length) {
      list.innerHTML = `<div class="empty-state" style="padding:20px"><p>${esc(uiText.no_errors || 'No errors')}</p></div>`;
      return;
    }
    list.innerHTML = errors.slice(0, 100).map(e => {
      let ctx = '';
      try { ctx = e.context_json ? JSON.parse(e.context_json) : {}; } catch (_) { ctx = {}; }
      const dev = e.device_name || e.device_id || '';
      const src = e.source ? `[${esc(e.source)}] ` : '';
      return `<div class="event-item">
        <div class="event-time">${esc(e.created_at || '')}</div>
        <div><strong>${esc(dev)}</strong> ${src}${esc(e.message || '')}</div>
        ${ctx && Object.keys(ctx).length ? `<div style="font-size:12px;color:var(--text-secondary);margin-top:4px">${esc(JSON.stringify(ctx))}</div>` : ''}
      </div>`;
    }).join('');
  }).catch(e => console.error('Errors load failed:', e));
}

// ─── Navigation ─────────────────────────────────────────────────────────────
function switchPage(page) {
  state.currentPage = page;
  document.querySelectorAll('.page-section').forEach(el => {
    el.classList.remove('active');
    el.style.display = '';
  });
  const pageEl = document.getElementById('page-' + page);
  if (pageEl) { pageEl.classList.add('active'); pageEl.style.display = 'block'; }
  document.querySelectorAll('.drawer-item[data-page]').forEach(el => {
    el.classList.toggle('active', el.dataset.page === page);
  });
  const statsStrip = document.querySelector('.stats-strip');
  const viewToggle = document.getElementById('viewToggle');
  if (page === 'home') {
    if (viewToggle) viewToggle.style.display = 'flex';
    if (statsStrip) statsStrip.style.display = state.homeView === 'tiles' ? 'grid' : 'none';
    if (state.homeView === 'map') {
      document.getElementById('page-home')?.classList.remove('active');
      document.getElementById('page-home').style.display = 'none';
      document.getElementById('page-map')?.classList.add('active');
      document.getElementById('page-map').style.display = 'block';
      fpUpdateMapMode();
      if (!FP.canvas) fpInit(); else { fpRebuildDeviceChips(); fpRender(); }
    } else {
      document.getElementById('page-map')?.classList.remove('active');
      document.getElementById('page-map').style.display = 'none';
      fpUpdateMapMode();
      renderHome();
    }
  } else {
    if (viewToggle) viewToggle.style.display = 'none';
    if (statsStrip) statsStrip.style.display = 'none';
    fpUpdateMapMode();
  }
  document.getElementById('appTitle').textContent = {
    home: uiText.app_title||'Smart Home',
    devices: uiText.devices,
    groups: uiText.groups,
    statistics: uiText.statistics,
    settings: uiText.settings,
    map: uiText.floor_plan,
  }[page] || 'Smart Home';
  closeDrawer();
  if (page === 'devices') renderDevicesTable();
  if (page === 'groups') renderGroups();
  if (page === 'statistics') renderStatistics();
  if (page === 'errors') renderErrors();
  if (page === 'map') {
    fpUpdateMapMode();
    if (!FP.canvas) fpInit(); else { fpBindMapZoom(); fpRebuildDeviceChips(); fpRender(); }
  }
  syncViewportMode();
}

function syncViewportMode() {
  const mapHome = state.currentPage === 'home' && state.homeView === 'map';
  document.body.classList.toggle('map-home-mode', mapHome);
}

// ─── Load State ─────────────────────────────────────────────────────────────
function fillHomeGroupSelect(selectedId) {
  const sel = document.getElementById('settingHomeGroup');
  if (!sel) return;
  const opts = (state.groups || []).map(g => `<option value="${esc(g.id)}"${g.id === selectedId ? ' selected' : ''}>${esc(g.name)}</option>`).join('');
  sel.innerHTML = '<option value="">—</option>' + opts;
}
function applyHomeViewToggle() {
  const container = document.getElementById('viewToggle');
  if (!container) return;
  container.querySelectorAll('button').forEach(btn => {
    const isMap = btn.dataset.view === 'map';
    btn.classList.toggle('active', isMap ? state.homeView === 'map' : state.homeView !== 'map');
  });
  syncViewportMode();
}
function applyHomeViewFromSettings() {
  state.homeView = (state.settings?.home_view === 'map') ? 'map' : 'tiles';
  applyHomeViewToggle();
}
function applySettingsForm() {
  const scope = state.settings?.home_scope || 'own';
  const scopeEl = document.getElementById('settingHomeScope');
  const wrap = document.getElementById('settingHomeGroupWrap');
  if (scopeEl) scopeEl.value = scope === 'group' ? 'group' : 'own';
  if (wrap) wrap.style.display = scope === 'group' ? 'block' : 'none';
  fillHomeGroupSelect(state.settings?.home_group_id || '');
  const hv = document.getElementById('settingHomeView');
  if (hv) hv.value = state.settings?.home_view === 'map' ? 'map' : 'tiles';
  const sd = document.getElementById('settingServerDomain');
  const ad = document.getElementById('settingApDomain');
  if (sd) { sd.value = state.settings?.server_domain || ''; sd.disabled = !state.canEditEndpoints; }
  if (ad) { ad.value = state.settings?.ap_domain || ''; ad.disabled = !state.canEditEndpoints; }
}
function loadState() {
  api('state').then(data => {
    state.settings = data.settings;
    state.devices = data.devices||[];
    state.myDevices = data.my_devices||data.devices||[];
    state.groups = data.groups||[];
    state.canEditEndpoints = !!data.can_edit_endpoints;
    state.canEditMap = data.can_edit_map !== false;
    state.homeScope = data.home_scope || 'own';
    state.homeGroupId = data.home_group_id || '';
    state.floorPlan = data.floor_plan||[];
    if (Array.isArray(state.floorPlan)) state.floorPlan = state.floorPlan.map(el => fpNormalizeElement(el));
    state.apiDocs = data.api_docs||'';
    applySettingsForm();
    applyHomeViewFromSettings();
    FP.elements = state.floorPlan;
    fpNormalizeElements();
    if (FP.history.length === 0 && FP.elements.length) {
      FP.history = [JSON.parse(JSON.stringify(FP.elements))];
      FP.histIdx = 0;
    }
    renderAll();
    if (state.currentPage === 'home') switchPage('home');
    if (FP.canvas) {
      fpRender();
      if (!FP._centeredOnce) { FP._centeredOnce = true; setTimeout(() => fpCenterMap(), 80); }
    }
    startRealtimeSync();
  }).catch(e => console.error('loadState error:', e));
}

const API_DOCS_COPY_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>';
const API_DOCS_COPIED_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22"><path d="M20 6L9 17l-5-5"/></svg>';
function copyTextToClipboard(text) {
  if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
    return navigator.clipboard.writeText(text);
  }
  return new Promise((resolve, reject) => {
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    try {
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      ok ? resolve() : reject(new Error('copy failed'));
    } catch (e) {
      document.body.removeChild(ta);
      reject(e);
    }
  });
}
const API_DOCS_ICONS = {
  lock: '<span class="api-docs-hicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg></span>',
  warn: '<span class="api-docs-callout-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>',
  list: '<span class="api-docs-hicon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span>',
};
const API_DOCS_EMOJI = { '\u{1F510}': 'lock', '\u26A0\uFE0F': 'warn', '\u{1F4CB}': 'list' };
function apiDocsStripEmojis(s, headingOnly) {
  let icon = '';
  let text = s;
  for (const [e, k] of Object.entries(API_DOCS_EMOJI)) {
    const hit = headingOnly ? text.startsWith(e) : text.includes(e);
    if (!hit) continue;
    if (!icon && API_DOCS_ICONS[k]) icon = API_DOCS_ICONS[k];
    text = headingOnly ? text.slice(e.length) : text.split(e).join('');
  }
  return { icon, text: text.replace(/^\s+/, '').replace(/\s{2,}/g, ' ').trim() };
}
function renderMarkdown(md) {
  const lines = String(md || '').split('\n');
  let html = '';
  let inPre = false;
  let preBuf = [];
  let listTag = '';
  let inTable = false;
  let tableHeaders = [];
  let tableRows = [];
  const flushList = () => { if (listTag) { html += `</${listTag}>`; listTag = ''; } };
  const closeTable = () => {
    if (!inTable) return;
    html += '<div class="api-docs-table-wrap"><table><thead><tr>';
    for (const h of tableHeaders) {
      html += `<th>${inline(h)}</th>`;
    }
    html += '</tr></thead><tbody>';
    for (const row of tableRows) {
      html += '<tr>';
      for (let ci = 0; ci < row.length; ci++) {
        const cell = row[ci] ?? '';
        html += `<td>${inline(cell)}</td>`;
      }
      html += '</tr>';
    }
    html += '</tbody></table></div>';
    inTable = false;
    tableHeaders = [];
    tableRows = [];
  };
  const inline = s => esc(s)
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i];
    if (line.startsWith('```')) {
      if (!inPre) { flushList(); closeTable(); inPre = true; preBuf = []; }
      else {
        inPre = false;
        html += `<pre><code>${esc(preBuf.join('\n'))}</code></pre>`;
        preBuf = [];
      }
      continue;
    }
    if (inPre) { preBuf.push(line); continue; }
    // Table detection (only when not inside a table already)
    if (!inTable && /^\|.*\|$/.test(line) && i + 1 < lines.length && /^\|?[-:|\s]+\|?$/.test(lines[i + 1])) {
      // Start of a markdown table
      flushList();
      // Capture header cells
      tableHeaders = line.split('|').slice(1, -1).map(s => s.trim());
      // Skip the separator line
      i++;
      inTable = true;
      continue;
    }
    if (inTable) {
      if (/^\|.*\|$/.test(line)) {
        const cells = line.split('|').slice(1, -1).map(s => s.trim());
        tableRows.push(cells);
        continue;
      } else {
        // End of table – emit HTML and reprocess current line
        closeTable();
        i--;
        continue;
      }
    }
    if (/^> /.test(line)) {
      flushList(); closeTable();
      const q = apiDocsStripEmojis(line.slice(2).trim(), false);
      const calloutIcon = q.icon || API_DOCS_ICONS.warn;
      html += `<div class="api-docs-callout">${calloutIcon}<p>${inline(q.text)}</p></div>`;
      continue;
    }
    if (/^### /.test(line)) { flushList(); const h = apiDocsStripEmojis(line.slice(4), true); html += `<h3>${h.icon}${inline(h.text)}</h3>`; continue; }
    if (/^## /.test(line)) { flushList(); const h = apiDocsStripEmojis(line.slice(3), true); html += `<h2>${h.icon}${inline(h.text)}</h2>`; continue; }
    if (/^# /.test(line)) { flushList(); const h = apiDocsStripEmojis(line.slice(2), true); html += `<h1>${h.icon}${inline(h.text)}</h1>`; continue; }
    if (/^[-*] /.test(line)) {
      if (listTag !== 'ul') { flushList(); html += '<ul>'; listTag = 'ul'; }
      html += `<li>${inline(line.slice(2))}</li>`;
      continue;
    }
    if (/^\d+\. /.test(line)) {
      if (listTag !== 'ol') { flushList(); html += '<ol>'; listTag = 'ol'; }
      html += `<li>${inline(line.replace(/^\d+\. /, ''))}</li>`;
      continue;
    }
    if (line.trim() === '') { flushList(); closeTable(); continue; }
    flushList(); closeTable();
    html += `<p>${inline(line)}</p>`;
  }
  flushList(); closeTable();
  if (inPre && preBuf.length) html += `<pre><code>${esc(preBuf.join('\n'))}</code></pre>`;
  return html;
}
function showApiDocsModal() {
  closeDrawer();
  const md = state.apiDocs || '';
  openModal(`<div class="modal-api-docs-head"><h2 class="modal-api-docs-title">${esc(uiText.api_docs)}</h2></div>
    <div class="modal-api-docs-scroll"><article class="api-docs-md" id="apiDocsRendered">${renderMarkdown(md)}</article></div>
    <button type="button" class="api-docs-copy-btn" id="apiDocsCopyBtn" title="${esc(uiText.api_docs_copy)}" aria-label="${esc(uiText.api_docs_copy)}">${API_DOCS_COPY_SVG}</button>`, { apiDocs: true });
  document.getElementById('apiDocsCopyBtn')?.addEventListener('click', copyApiDocs);
}
function copyApiDocs() {
  const text = state.apiDocs || '';
  const btn = document.getElementById('apiDocsCopyBtn');
  const done = () => {
    if (!btn) return;
    if (!btn.dataset.copyIcon) btn.dataset.copyIcon = btn.innerHTML;
    btn.innerHTML = API_DOCS_COPIED_SVG;
    btn.classList.add('copied');
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = btn.dataset.copyIcon || API_DOCS_COPY_SVG;
    }, 1600);
  };
  copyTextToClipboard(text).then(done).catch(() => uiAlert(uiText.copy_failed));
}

function renderAll() {
  renderHome();
  if (state.currentPage === 'devices') renderDevicesTable();
  if (state.currentPage === 'groups') renderGroups();
}

function fpMapCoordWheelInput(el) {
  if (!(el instanceof HTMLInputElement) || el.type !== 'number') return false;
  if (!el.closest('#mapPropsBody')) return false;
  const k = el.dataset.k, pk = el.dataset.pvk;
  return (k && ['x','y','x2','y2','w','h'].includes(k)) || (pk && ['x','y'].includes(pk));
}
function modalWheelScrollTarget(node, deltaY) {
  let el = node;
  while (el && el.id !== 'modalOverlay') {
    const oy = getComputedStyle(el).overflowY;
    if ((oy === 'auto' || oy === 'scroll' || oy === 'overlay') && el.scrollHeight > el.clientHeight + 1) {
      const max = el.scrollHeight - el.clientHeight;
      if (deltaY < 0 && el.scrollTop > 0) return el;
      if (deltaY > 0 && el.scrollTop < max - 1) return el;
    }
    el = el.parentElement;
  }
  const mc = document.getElementById('modalContent');
  return mc?.querySelector('.modal-api-docs-scroll') || mc;
}
function setupModalWheelScroll() {
  const overlay = document.getElementById('modalOverlay');
  overlay?.addEventListener('wheel', e => {
    if (!overlay.classList.contains('open')) return;
    const scrollEl = modalWheelScrollTarget(e.target, e.deltaY);
    if (scrollEl && scrollEl.scrollHeight > scrollEl.clientHeight) {
      const prev = scrollEl.scrollTop;
      scrollEl.scrollTop += e.deltaY;
      if (scrollEl.scrollTop !== prev) { e.preventDefault(); return; }
    }
    e.preventDefault();
  }, { passive: false });
}
function setupWheelInputs() {
  document.addEventListener('wheel', e => {
    const el = e.target;
    if (!(el instanceof HTMLInputElement || el instanceof HTMLSelectElement)) return;
    if (el.disabled || el.readOnly) return;
    if (el.type === 'number' || el.type === 'range') {
      e.preventDefault();
      const mapGrid = fpMapCoordWheelInput(el);
      const step = mapGrid ? FP.snap : (parseFloat(el.step) || 1);
      const min = el.min !== '' ? parseFloat(el.min) : -Infinity;
      const max = el.max !== '' ? parseFloat(el.max) : Infinity;
      let v = parseFloat(el.value);
      if (Number.isNaN(v)) v = 0;
      v += e.deltaY < 0 ? step : -step;
      v = Math.min(max, Math.max(min, v));
      if (mapGrid) v = fpSnap(v);
      const dec = mapGrid ? 0 : (String(step).split('.')[1] || '').length;
      el.value = dec ? v.toFixed(dec) : String(Math.round(v));
      el.dispatchEvent(new Event('input', { bubbles: true }));
      el.dispatchEvent(new Event('change', { bubbles: true }));
      return;
    }
    if (el.tagName === 'SELECT' && !el.multiple) {
      e.preventDefault();
      const i = e.deltaY < 0 ? Math.max(0, el.selectedIndex - 1) : Math.min(el.options.length - 1, el.selectedIndex + 1);
      if (i !== el.selectedIndex) {
        el.selectedIndex = i;
        el.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
  }, { passive: false });
}

// ─── Event Listeners ────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  setupWheelInputs();
  setupModalWheelScroll();
  // Menu
  document.getElementById('menuToggle').addEventListener('click', toggleDrawer);
  document.getElementById('drawerOverlay').addEventListener('click', closeDrawer);

  // Navigation
  document.querySelectorAll('.drawer-item').forEach(el => {
    el.addEventListener('click', () => switchPage(el.dataset.page));
  });

  // Modal
  document.getElementById('modalClose').addEventListener('click', closeModal);
  document.getElementById('modalOverlay').addEventListener('click', e => {
    if (e.target === e.currentTarget) closeModal();
  });
  // Add device
  document.getElementById('addDeviceBtn').addEventListener('click', showAddDeviceForm);
  document.getElementById('deviceTableAdd').addEventListener('click', showAddDeviceForm);

  // Device search
  document.getElementById('deviceSearch')?.addEventListener('input', renderDevicesTable);

  // Create group
  document.getElementById('createGroupBtn').addEventListener('click', () => {
    openModal(`<h2>${esc(uiText.create_group)}</h2>
      <div class="form-group"><label>${esc(uiText.group_name)}</label><input type="text" id="newGroupName" placeholder="Group name"></div>
      <button class="btn btn-primary" onclick="createGroup()">${esc(uiText.create_group)}</button>`);
  });

  document.getElementById('settingHomeScope')?.addEventListener('change', e => {
    const wrap = document.getElementById('settingHomeGroupWrap');
    if (wrap) wrap.style.display = e.target.value === 'group' ? 'block' : 'none';
  });
  document.getElementById('saveSettingsBtn').addEventListener('click', () => {
    const payload = {
      home_scope: document.getElementById('settingHomeScope')?.value || 'own',
      home_group_id: document.getElementById('settingHomeGroup')?.value || '',
      home_view: document.getElementById('settingHomeView')?.value === 'map' ? 'map' : 'tiles',
    };
    if (state.canEditEndpoints) {
      payload.server_domain = document.getElementById('settingServerDomain').value.trim();
      payload.ap_domain = document.getElementById('settingApDomain').value.trim();
    }
    api('save_settings', payload).then(data => {
      state.settings = data.settings || state.settings;
      if (data.can_edit_endpoints !== undefined) state.canEditEndpoints = data.can_edit_endpoints;
      applySettingsForm();
      applyHomeViewFromSettings();
      return loadState();
    }).then(() => {
      if (state.currentPage === 'home') switchPage('home');
      uiToast(uiText.saved_ok);
    }).catch(e => uiAlert(e.message));
  });

  // Refresh stats
  document.getElementById('refreshStats').addEventListener('click', renderStatistics);
  document.getElementById('statsPeriod')?.addEventListener('change', renderStatistics);
  document.getElementById('refreshErrors')?.addEventListener('click', renderErrors);
  document.getElementById('errorsPeriod')?.addEventListener('change', renderErrors);

  document.getElementById('roomsContainer').addEventListener('click', e => {
    const card = e.target.closest('.device-card');
    if (card && !e.target.closest('.card-control-chip')) {
      showDeviceView(card.dataset.id);
    }
  });

  document.getElementById('openApiDocsBtn')?.addEventListener('click', showApiDocsModal);

  loadState();
});

// ─── Add Device Form ────────────────────────────────────────────────────────
const DEVICE_CAT_NEW = '__new__';
function getDeviceCategories() {
  const set = new Set();
  [...(state.devices || []), ...(state.myDevices || [])].forEach(d => {
    const c = (d.category || '').trim();
    if (c) set.add(c);
  });
  return [...set].sort((a, b) => a.localeCompare(b));
}
function deviceCategorySelectHtml(allowNew) {
  const cats = getDeviceCategories();
  let html = `<option value="">—</option>`;
  cats.forEach(c => { html += `<option value="${esc(c)}">${esc(c)}</option>`; });
  if (allowNew) html += `<option value="${DEVICE_CAT_NEW}">${esc(uiText.category_new_option)}</option>`;
  return html;
}
function readDeviceCategory(selectId, newInputId) {
  const sel = document.getElementById(selectId);
  if (!sel) return '';
  if (sel.value === DEVICE_CAT_NEW) return document.getElementById(newInputId)?.value.trim() || '';
  return sel.value.trim();
}
function bindDeviceCategorySelect(selectId, wrapId) {
  const sel = document.getElementById(selectId);
  const wrap = document.getElementById(wrapId);
  if (!sel || !wrap) return;
  const sync = () => { wrap.style.display = sel.value === DEVICE_CAT_NEW ? 'block' : 'none'; };
  sel.addEventListener('change', sync);
  sync();
}
function showAddDeviceForm() {
  const html = `<h2 class="modal-title">${esc(uiText.add_device)}</h2>
  <div class="form-group">
    <label>${esc(uiText.device_category)}</label>
    <select id="formDeviceCategory">${deviceCategorySelectHtml(true)}</select>
  </div>
  <div class="form-group" id="formDeviceCategoryNewWrap" style="display:none">
    <label>${esc(uiText.category_new_name)}</label>
    <input type="text" id="formDeviceCategoryNew" placeholder="${esc(uiText.device_category)}">
  </div>
  <div class="form-group">
    <label>${esc(uiText.device_token)}</label>
    <input type="text" id="formDeviceToken" placeholder="${esc(uiText.device_token)}" autocomplete="off" spellcheck="false">
    <p style="font-size:12px;color:var(--text-secondary);margin-top:8px;line-height:1.45">${esc(uiText.add_device_token_hint)}</p>
  </div>
  <button type="button" class="btn btn-primary" id="submitAddDeviceBtn">${esc(uiText.save)}</button>`;
  openModal(html);
  bindDeviceCategorySelect('formDeviceCategory', 'formDeviceCategoryNewWrap');
  document.getElementById('submitAddDeviceBtn')?.addEventListener('click', submitAddDevice);
  document.getElementById('formDeviceToken')?.addEventListener('keydown', e => { if (e.key === 'Enter') submitAddDevice(); });
  setTimeout(() => document.getElementById('formDeviceToken')?.focus(), 80);
}
function submitAddDevice() {
  const category = readDeviceCategory('formDeviceCategory', 'formDeviceCategoryNew');
  const token = document.getElementById('formDeviceToken')?.value.trim();
  if (!category) { uiAlert(uiText.device_category); return; }
  if (!token) { uiAlert(uiText.device_token); return; }
  api('save_device', {
    device_token: token,
    category,
    server_domain: state.settings.server_domain,
    ap_domain: state.settings.ap_domain,
  }).then(data => {
    closeModal();
    if (data.devices) applyDevicesFromApi(data);
    else loadState();
  }).catch(e => uiAlert(e.message));
}

// ─── Create Group ───────────────────────────────────────────────────────────
function createGroup() {
  const name = document.getElementById('newGroupName')?.value.trim();
  if (!name) { uiAlert(uiText.group_name); return; }
  api('create_group', { name }).then(data => {
    closeModal();
    loadState();
  }).catch(e => uiAlert(e.message));
}

