import type { ConfigPlugin } from "expo/config-plugins.js"
import configPlugins from "expo/config-plugins.js"

import fs from "node:fs"
import path from "node:path"

const { withAppBuildGradle, withDangerousMod } = configPlugins

/**
 * Release signing for the Android build.
 *
 * The native `android/` project is generated by `expo prebuild`, so the
 * signing configuration has to be injected by a config plugin instead of
 * being committed. Credentials are read from the environment:
 *
 *   KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD
 *
 * The keystore itself lives at `app/release.jks` (gitignored) and is copied
 * into the generated native project during prebuild.
 */

const KEYSTORE_FILE = "release.jks"

/**
 * Locations that may hold the release keystore, relative to the Expo
 * project root. The publish script keeps the canonical copy in `app/`, but
 * the project root is accepted as well so local builds work either way.
 */
const KEYSTORE_CANDIDATES = [
  path.join("app", KEYSTORE_FILE),
  KEYSTORE_FILE,
] as const

/**
 * Release signing config injected into the generated `signingConfigs` block.
 * It mirrors the Kanboard/StepMonitor setup: use the release keystore when
 * the credentials are present, otherwise fall back to the debug keystore so
 * local debug builds keep working.
 */
export const RELEASE_SIGNING_BLOCK = `        release {
            def releaseKeystoreFile = file('${KEYSTORE_FILE}')
            def releaseStorePassword = System.getenv('KEYSTORE_PASSWORD')
            def releaseKeyAlias = System.getenv('KEY_ALIAS')
            def releaseKeyPassword = System.getenv('KEY_PASSWORD')
            if (releaseKeystoreFile.exists() && releaseStorePassword) {
                storeFile releaseKeystoreFile
                storePassword releaseStorePassword
                keyAlias releaseKeyAlias
                keyPassword releaseKeyPassword
            } else {
                storeFile file('debug.keystore')
                storePassword 'android'
                keyAlias 'androiddebugkey'
                keyPassword 'android'
            }
        }`

/**
 * Extract the body of the `signingConfigs { ... }` block from the generated
 * Gradle file, or null when the block is missing.
 */
function findSigningConfigsBlock(src: string): { start: number; end: number } | null {
  const start = src.indexOf("signingConfigs {")
  if (start === -1) return null

  let depth = 0
  for (let i = src.indexOf("{", start); i < src.length; i += 1) {
    const char = src[i]
    if (char === "{") depth += 1
    else if (char === "}") {
      depth -= 1
      if (depth === 0) return { start, end: i + 1 }
    }
  }
  return null
}

/**
 * Patch the generated `app/build.gradle` so release builds use the release
 * signing config instead of the debug keystore.
 *
 * Exported separately from the config plugin so it can be unit tested.
 */
export function patchBuildGradleForReleaseSigning(src: string): string {
  let patched = src

  // Add a `release` signing config to the generated signingConfigs block.
  const signingConfigs = findSigningConfigsBlock(patched)
  if (signingConfigs) {
    const block = patched.slice(signingConfigs.start, signingConfigs.end)
    if (!/\brelease\s*\{/.test(block)) {
      patched =
        patched.slice(0, signingConfigs.start) +
        patched.slice(signingConfigs.start).replace(
          /(signingConfigs\s*\{)/,
          `$1\n${RELEASE_SIGNING_BLOCK}\n`,
        )
    }
  }

  // Point the release build type at the release signing config. The
  // generated project ships with `signingConfig signingConfigs.debug`,
  // which would publish a debug-signed APK.
  const buildTypesIndex = patched.indexOf("buildTypes {")
  if (buildTypesIndex !== -1) {
    const head = patched.slice(0, buildTypesIndex)
    const tail = patched.slice(buildTypesIndex)
    patched =
      head +
      tail.replace(
        /(release\s*\{[^}]*?)signingConfig\s+signingConfigs\.debug/,
        "$1signingConfig signingConfigs.release",
      )
  }

  return patched
}

const withReleaseSigningConfig: ConfigPlugin = (config) =>
  withAppBuildGradle(config, (cfg) => {
    cfg.modResults.contents = patchBuildGradleForReleaseSigning(
      cfg.modResults.contents,
    )
    return cfg
  })

const withKeystoreCopy: ConfigPlugin = (config) =>
  withDangerousMod(config, [
    "android",
    async (cfg) => {
      const destDir = path.join(cfg.modRequest.platformProjectRoot, "app")
      const dest = path.join(destDir, KEYSTORE_FILE)

      const source = KEYSTORE_CANDIDATES.map((relativePath) =>
        path.join(cfg.modRequest.projectRoot, relativePath),
      ).find((candidate) => fs.existsSync(candidate))

      // Without a keystore there is nothing to copy: debug builds must keep
      // working. Release builds are rejected later by the publish script,
      // which verifies the signature of the produced APK.
      if (!source) {
        console.warn(
          `with-android-release-signing: keystore file not found in ${KEYSTORE_CANDIDATES.join(", ")} under ${cfg.modRequest.projectRoot}; release builds will not be signed with the release key.`,
        )
        return cfg
      }
      fs.mkdirSync(destDir, { recursive: true })
      fs.copyFileSync(source, dest)
      return cfg
    },
  ])

const withAndroidReleaseSigning: ConfigPlugin = (config) => {
  config = withKeystoreCopy(config)
  config = withReleaseSigningConfig(config)
  return config
}

export default withAndroidReleaseSigning
