    <string name="onboarding_welcome_subtitle">Inoltra automaticamente i tuoi dati sanitari a qualsiasi StepMonitor service.</string>
    <string name="onboarding_thank_you">Grazie per il tuo supporto!</string>
    <string name="onboarding_thank_you_title">Tutto pronto!</string>
    <string name="onboarding_thank_you_desc">Configura i StepMonitor service e avvia la sincronizzazione. Se qualcosa non funziona o vuoi una nuova funzione, apri Impostazioni → Fornire contact.</string>
    
    <string name="onboarding_feature1_title">Scegli cosa sincronizzare</string>
    <string name="onboarding_feature1_desc">Seleziona solo i tipi di dati sanitari che desideri inoltrare.</string>
    <string name="onboarding_feature2_title">Invia a qualsiasi URL StepMonitor service</string>
    <string name="onboarding_feature2_desc">I tuoi dati vanno direttamente ai tuoi URL configurati, da nessun’altra parte.</string>
    <string name="onboarding_feature3_title">Autorizzazioni su richiesta</string>
    <string name="onboarding_feature3_desc">Le autorizzazioni Health Connect vengono richieste solo per i tipi che attivi.</string>

