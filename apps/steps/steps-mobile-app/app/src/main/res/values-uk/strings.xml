    <string name="onboarding_welcome_title">StepMonitor</string>
    <string name="onboarding_welcome_subtitle">Forward your health data to any StepMonitor service — automatically.</string>
    <string name="onboarding_thank_you">Thank you for your support!</string>
    <string name="onboarding_thank_you_title">You\'re all set!</string>
    <string name="onboarding_thank_you_desc">Configure your data sync and start syncing. If something breaks or you want a new feature, open Settings → Contact admin.</string>
    
    <string name="onboarding_feature1_title">You choose what to sync</string>
    <string name="onboarding_feature1_desc">Select only the health data types you want to forward.</string>
    <string name="onboarding_feature2_title">Send to any StepMonitor service URL</string>
    <string name="onboarding_feature2_desc">Your data goes directly to your configured URLs — nothing else.</string>
    <string name="onboarding_feature3_title">Permissions on demand</string>
    <string name="onboarding_feature3_desc">Health Connect permissions are requested only for the types you enable.</string>

    <string name="onboarding_datatypes_title">Available Data Types</string>
    <string name="onboarding_datatypes_desc">Choose from %1$d health data types to forward to your StepMonitor service. You’re in full control — only what you turn on gets synced.</string>
    <string name="onboarding_group_activity">Activity</string>
    <string name="onboarding_group_heart_vitals">Heart &amp; Vitals</string>
    <string name="onboarding_group_sleep">Sleep</string>
    <string name="onboarding_group_body_composition">Body Composition</string>
    <string name="onboarding_group_nutrition">Nutrition &amp; Hydration</string>
    <string name="onboarding_group_cycle_tracking">Cycle Tracking</string>
    
    <string name="onboarding_privacy_title">Your Data, Your Control</string>
    <string name="onboarding_privacy_subtitle">This app is a transparent forwarder. Here’s exactly how your data is handled:</string>
    <string name="onboarding_privacy_p1">You decide which health data types to enable — nothing is read without your choice</string>
    <string name="onboarding_privacy_p2">Permissions are only asked for the types you turn on. If you never enable a type, its permission is never requested</string>
    <string name="onboarding_privacy_p3">Your data is sent directly to your own StepMonitor service URLs — nowhere else</string>
    <string name="onboarding_privacy_p4">Nothing is stored on any external server</string>
    <string name="onboarding_privacy_p5">Your data is never sold or shared with anyone</string>
    <string name="onboarding_privacy_footer">Have contact or suggestions? Open the Settings tab anytime and tap Contact admin.</string>
    <string name="onboarding_privacy_warning_title">Use only the official version</string>
    <string name="onboarding_privacy_warning_desc">Cracked or modified versions of this app may steal your StepMonitor service URLs or send your health data to unknown servers. Always download from AppDashboard.</string>
    <string name="medical_disclaimer_title">This app is not a medical device</string>
    <string name="medical_disclaimer_desc">This app is not a medical device and is not intended to diagnose, treat, cure, or prevent any medical condition or disease. Health data displayed is sourced from Health Connect and is for personal informational purposes only. Always consult a qualified healthcare professional for medical advice.</string>
    <string name="dt_steps_name">Кроки</string>
    <string name="dt_steps_rationale">Track daily step counts and send activity totals to your StepMonitor service for fitness automation and habit tracking.</string>
    <string name="dt_sleep_name">Сон</string>
    <string name="dt_sleep_rationale">Forward sleep session duration and stage breakdowns (light, deep, REM) to build custom sleep reports or recovery dashboards.</string>
    <string name="dt_hr_name">Пульс</string>
    <string name="dt_hr_rationale">Stream continuous heart rate readings to your StepMonitor service for real-time health monitoring, alerts, or workout analysis.</string>
    <string name="dt_hrv_name">Варіабельність серцевого ритму</string>
    <string name="dt_hrv_rationale">Send HRV (RMSSD) readings to your StepMonitor service to track stress levels, recovery quality, and nervous system health over time.</string>
    <string name="dt_dist_name">Дистанція</string>
    <string name="dt_dist_rationale">Forward daily distance traveled to log running, walking, or cycling progress and trigger location-based automations.</string>
    <string name="dt_act_cal_name">Активні калорії</string>
    <string name="dt_act_cal_rationale">Send active calorie burn data to your StepMonitor service to power fitness tracking, nutrition planning, or goal-based automations.</string>
    <string name="dt_tot_cal_name">Усього калорій</string>
    <string name="dt_tot_cal_rationale">Forward total daily calorie expenditure for comprehensive energy balance tracking and diet management workflows.</string>
    <string name="dt_weight_name">Вага</string>
    <string name="dt_weight_rationale">Sync body weight measurements to your StepMonitor service to track trends, calculate BMI, or trigger health goal notifications.</string>
    <string name="dt_height_name">Зріст</string>
    <string name="dt_height_rationale">Send height data to your StepMonitor service to enable BMI and body composition calculations in downstream automations.</string>
    <string name="dt_bp_name">Артеріальний тиск</string>
    <string name="dt_bp_rationale">Forward systolic and diastolic readings to monitor cardiovascular health, log trends, and set up alert workflows.</string>
    <string name="dt_bg_name">Глюкоза в крові</string>
    <string name="dt_bg_rationale">Send blood glucose levels to your StepMonitor service to support diabetes management, meal tracking, and health alert automations.</string>
    <string name="dt_oxy_name">Насичення киснем</string>
    <string name="dt_oxy_rationale">Forward SpO₂ readings to monitor respiratory health, flag low-oxygen events, and integrate with wellness dashboards.</string>
    <string name="dt_temp_name">Температура тіла</string>
    <string name="dt_temp_rationale">Send body temperature readings to your StepMonitor service for illness detection, fever tracking, and long-term health logging.</string>
    <string name="dt_skin_temp_name">Температура шкіри</string>
    <string name="dt_skin_temp_rationale">Forward skin temperature deltas from wearables (for example overnight readings) to your StepMonitor service for cycle tracking and wellness dashboards.</string>
    <string name="dt_resp_name">Частота дихання</string>
    <string name="dt_resp_rationale">Forward breathing rate data to track respiratory health, monitor recovery, and detect anomalies via your StepMonitor service.</string>
    <string name="dt_rhr_name">Пульс у спокої</string>
    <string name="dt_rhr_rationale">Send daily resting heart rate to your StepMonitor service to track long-term cardiovascular fitness trends and training adaptation.</string>
    <string name="dt_exer_name">Тренування</string>
    <string name="dt_exer_rationale">Forward workout sessions including exercise type and duration to your StepMonitor service for activity logging and training analysis.</string>
    <string name="dt_hydr_name">Гідратація</string>
    <string name="dt_hydr_rationale">Send fluid intake logs to your StepMonitor service to support daily hydration tracking, reminders, and wellness automations.</string>
    <string name="dt_nutr_name">Харчування</string>
    <string name="dt_nutr_rationale">Forward calorie and macronutrient (protein, carbs, fat) data to power diet tracking and nutrition automation workflows.</string>
    <string name="dt_bmr_name">Базовий обмін речовин</string>
    <string name="dt_bmr_rationale">Send BMR data to your StepMonitor service to enable personalized calorie target calculations and metabolism tracking dashboards.</string>
    <string name="dt_bf_name">Відсоток жиру</string>
    <string name="dt_bf_rationale">Forward body fat percentage measurements to your StepMonitor service to track body composition changes and fitness progress over time.</string>
    <string name="dt_lbm_name">М\'язова маса</string>
    <string name="dt_lbm_rationale">Send lean mass data to your StepMonitor service to monitor muscle gain or loss and support body recomposition tracking workflows.</string>
    <string name="dt_bwm_name">Вміст води в тілі</string>
    <string name="dt_bwm_rationale">Forward body water mass measurements to your StepMonitor service to track hydration and body composition from smart scales.</string>
    <string name="dt_vo2_name">VO₂ max</string>
    <string name="dt_vo2_rationale">Forward VO₂ max readings to your StepMonitor service to track aerobic fitness improvements, training load, and endurance progress.</string>
    <string name="dt_bone_name">Кісткова маса</string>
    <string name="dt_bone_rationale">Send bone density measurements to your StepMonitor service to track skeletal health and monitor long-term wellness trends.</string>
    <string name="dt_menstruation_flow_name">Менструальні виділення</string>
    <string name="dt_menstruation_flow_rationale">Forward menstrual flow intensity readings to your StepMonitor service to track cycle patterns, symptoms, and trends over time.</string>
    <string name="dt_menstruation_period_name">Менструальний період</string>
    <string name="dt_menstruation_period_rationale">Send period start and end dates to your StepMonitor service to log cycle length, predict future periods, and power reproductive health workflows.</string>
    <string name="dt_intermenstrual_bleeding_name">Кровотеча між менструаціями</string>
    <string name="dt_intermenstrual_bleeding_rationale">Forward spotting or bleeding events that occur between periods to your StepMonitor service for detailed cycle and health monitoring.</string>
    <string name="dt_ovulation_test_name">Тест на овуляцію</string>
    <string name="dt_ovulation_test_rationale">Send ovulation test results to your StepMonitor service to track fertility windows, predict ovulation, and support family planning workflows.</string>
    <string name="dt_cervical_mucus_name">Цервікальний слиз</string>
    <string name="dt_cervical_mucus_rationale">Forward cervical mucus observations to your StepMonitor service to support fertility awareness methods and cycle-phase tracking.</string>
    <string name="dt_sexual_activity_name">Статева активність</string>
    <string name="dt_sexual_activity_rationale">Send sexual activity logs to your StepMonitor service to correlate with cycle data, track patterns, and support reproductive health insights.</string>
    <string name="dt_basal_body_temp_name">Базальна температура тіла</string>
    <string name="dt_basal_body_temp_rationale">Forward morning basal body temperature readings to your StepMonitor service to detect ovulation, track cycle phases, and support fertility awareness charting.</string>
    <string name="dt_hc_rationale">StepMonitor requires access to your health and fitness data. This data is strictly used to fulfill the core functionality of the app: securely transmitting your chosen health metrics directly to your personal StepMonitor service URLs. We do not sell or share your data with any third parties. Only the data types you explicitly choose to configure below will be requested and synced.</string>
