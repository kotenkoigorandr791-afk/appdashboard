    <string name="onboarding_welcome_title">Health Connect para StepMonitor service</string>
    <string name="onboarding_welcome_subtitle">Encaminhe seus dados de saúde para qualquer StepMonitor service — automaticamente.</string>
    <string name="onboarding_thank_you">Obrigado pelo seu apoio!</string>
    <string name="onboarding_thank_you_title">Tudo pronto!</string>
    <string name="onboarding_thank_you_desc">Configure seus data sync e comece a sincronizar. Se algo falhar ou você quiser um novo recurso, abra Configurações → Fornecer comentários.</string>
    
    <string name="onboarding_feature1_title">Você escolhe o que sincronizar</string>
    <string name="onboarding_feature1_desc">Selecione apenas os tipos de dados de saúde que deseja encaminhar.</string>
    <string name="onboarding_feature2_title">Enviar para qualquer URL de StepMonitor service</string>
    <string name="onboarding_feature2_desc">Seus dados vão diretamente para seus URLs configurados — e para mais nenhum outro lugar.</string>
    <string name="onboarding_feature3_title">Permissões sob demanda</string>
    <string name="onboarding_feature3_desc">As permissões do Health Connect são solicitadas apenas para os tipos que você ativar.</string>

