    <string name="onboarding_privacy_title">Seus Dados, Seu Controle</string>
    <string name="onboarding_privacy_subtitle">Este aplicativo é um encaminhador transparente. Veja exatamente como seus dados são tratados:</string>
    <string name="onboarding_privacy_p1">Você decide quais tipos de dados de saúde ativar — nada é lido sem a sua escolha</string>
    <string name="onboarding_privacy_p2">As permissões são solicitadas apenas para os tipos que você ativar. Se você nunca habilitar um tipo, a permissão nunca será solicitada</string>
    <string name="onboarding_privacy_p3">Seus dados são enviados diretamente para seus próprios URLs de StepMonitor service — para nenhum outro lugar</string>
    <string name="onboarding_privacy_p4">Nada é armazenado em nenhum servidor externo</string>
    <string name="onboarding_privacy_p5">Seus dados nunca são vendidos ou compartilhados com ninguém</string>
    <string name="onboarding_privacy_footer">Tem comentários ou sugestões? Abra a guia Configurações a qualquer momento e toque em Fornecer comentários.</string>
    <string name="onboarding_privacy_warning_title">Use apenas a versão oficial</string>
    <string name="onboarding_privacy_warning_desc">Versões piratas ou modificadas deste aplicativo podem roubar seus URLs de StepMonitor service ou enviar seus dados de saúde para servidores desconhecidos. Baixe sempre do AppDashboard.</string>
    <string name="medical_disclaimer_title">Este app não é um dispositivo médico</string>
    <string name="medical_disclaimer_desc">Este aplicativo não é um dispositivo médico e não se destina a diagnosticar, tratar, curar ou prevenir qualquer doença ou condição médica. Os dados de saúde exibidos são provenientes do Health Connect e têm finalidade exclusivamente informativa e pessoal. Consulte sempre um profissional de saúde qualificado para obter orientação médica.</string>
    <string name="dt_steps_name">Passos</string>
    <string name="dt_steps_rationale">Acompanhe seus passos diários e envie ao seu StepMonitor service para automação fitness.</string>
    <string name="dt_sleep_name">Sono</string>
    <string name="dt_sleep_rationale">Encaminhe as sessões e as fases do sono (leve, profundo) para relatórios de descanso personalizados.</string>
    <string name="dt_hr_name">Frequência Cardíaca</string>
    <string name="dt_hr_rationale">Envie os batimentos cardíacos ao StepMonitor service para análises esportivas em tempo real.</string>
    <string name="dt_hrv_name">Variabilidade da Frequência Cardíaca</string>
    <string name="dt_hrv_rationale">Acompanhe métricas (RMSSD) para quantificar o estresse ou recuperação nervosa do corpo via StepMonitor service.</string>
    <string name="dt_dist_name">Distância</string>
    <string name="dt_dist_rationale">Direcione o percurso obtido no dia nas suas rotas físicas ativados no envio automatizado do StepMonitor service.</string>
    <string name="dt_act_cal_name">Calorias Ativas</string>
    <string name="dt_act_cal_rationale">Transporte queimas ativas das massas com envios a rotinas nutricionais em plataformas no seu StepMonitor service.</string>
    <string name="dt_tot_cal_name">Calorias Totais</string>
    <string name="dt_tot_cal_rationale">Repasse do total das massas e balanços aos envios contínuos alimentados do StepMonitor service a suas rotinas do peso.</string>
    <string name="dt_weight_name">Peso</string>
    <string name="dt_weight_rationale">Sincronize monitoramentos corporais no acompanhamento pelo StepMonitor service perante ao resultado do seu IMC a prazo.</string>
    <string name="dt_height_name">Altura</string>
    <string name="dt_height_rationale">Envie suas medidas contendo a dimensão corporal no cálculo feito de rotina repassado a relatórios pelo seu StepMonitor service.</string>
    <string name="dt_bp_name">Pressão Arterial</string>
    <string name="dt_bp_rationale">Alimente a medição vascular alertando riscos em envios sincronizados ao seu StepMonitor service sobre sua circulação.</string>
    <string name="dt_bg_name">Glicose no Sangue</string>
    <string name="dt_bg_rationale">Gere monitoração do que alimenta ou sofre restrição de uso de taxas no seu relatório glicêmico enviado do StepMonitor service.</string>
    <string name="dt_oxy_name">Saturação de Oxigênio</string>
    <string name="dt_oxy_rationale">Empréstimo da taxa lida ao painel das vias de sua mecânica em envios constantes automatizados a teu StepMonitor service.</string>
    <string name="dt_temp_name">Temperatura Corporal</string>
    <string name="dt_temp_rationale">Alimente dores sintomáticas avaliados pelo StepMonitor service no controle contínuo durante seus percursos febris monitorando-se.</string>
    <string name="dt_skin_temp_name">Temperatura da pele</string>
    <string name="dt_skin_temp_rationale">Envie variações de temperatura da pele de dispositivos vestíveis para o seu StepMonitor service para bem-estar e análise do sono.</string>
    <string name="dt_resp_name">Frequência Respiratória</string>
    <string name="dt_resp_rationale">O balanço inspiratório gerido via StepMonitor service acompanhando recuperações para relatórios integrados baseados ou físicos da saúde.</string>
    <string name="dt_rhr_name">Frequência Cardíaca de Repouso</string>
    <string name="dt_rhr_rationale">Envie o reflexo gerido do uso ou desuso em picos na tranquilidade mandados para treinos avaliativos através StepMonitor service.</string>
    <string name="dt_exer_name">Sessões de Exercício</string>
    <string name="dt_exer_rationale">Transporte a natureza específica de treinos com o transcurso de horas num modelo contábil que te ajuda na sua StepMonitor service.</string>
    <string name="dt_hydr_name">Hidratação</string>
    <string name="dt_hydr_rationale">O balanço da umidade que engloba sua automação diária para envios via relatórios de seu painel aos usuários remotos em uso.</string>
    <string name="dt_nutr_name">Nutrição</string>
    <string name="dt_nutr_rationale">Envia a carga do sistema alimentar enviada na gestão dietética contendo níveis ao StepMonitor service aos processos contábeis nutricionais.</string>
    <string name="dt_bmr_name">Taxa Metabólica Basal</string>
    <string name="dt_bmr_rationale">Capta a energia natural fornecida na rotina mandada de relatórios às bases integradas alimentares ao longo do teu tempo e o StepMonitor service.</string>
    <string name="dt_bf_name">Gordura Corporal</string>
    <string name="dt_bf_rationale">Registra e direciona volumes nos rastreios no corpo enviando dados ao StepMonitor service nas finalizações desportivas contábeis.</string>
    <string name="dt_lbm_name">Massa Corporal Magra</string>
    <string name="dt_lbm_rationale">Massa enxuta encaminhada a base contábil para recompor teu painéis enviando via StepMonitor service no progresso e acompanhamento estrito teu corpo.</string>
    <string name="dt_bwm_name">Massa de água corporal</string>
    <string name="dt_bwm_rationale">Envie medições de massa de água corporal ao StepMonitor service para acompanhar hidratação e composição corporal de balanças inteligentes.</string>
    <string name="dt_vo2_name">VO₂ Máx</string>
    <string name="dt_vo2_rationale">Sinalize seus limites respiratórios na rotina gerada enviando sua taxa de força cardiorrespiratória ao painel com seu StepMonitor service acompanhando sua base.</string>
    <string name="dt_bone_name">Massa Óssea</string>
    <string name="dt_bone_rationale">Acompanhamento que sinaliza medição preventiva ou progressiva avaliando em relatórios mandadas à base num StepMonitor service suas tendências.</string>
    <string name="dt_menstruation_flow_name">Fluxo menstrual</string>
    <string name="dt_menstruation_flow_rationale">Envie dados de intensidade do fluxo menstrual ao seu StepMonitor service para rastrear padrões de ciclo, sintomas e tendências ao longo do tempo.</string>
    <string name="dt_menstruation_period_name">Período menstrual</string>
    <string name="dt_menstruation_period_rationale">Registre as datas de início e fim do ciclo no seu StepMonitor service para documentar a duração do ciclo e automatizar fluxos de saúde reprodutiva.</string>
    <string name="dt_intermenstrual_bleeding_name">Sangramento intermenstrual</string>
    <string name="dt_intermenstrual_bleeding_rationale">Encaminhe eventos de sangramento ou manchas entre os ciclos ao seu StepMonitor service para um monitoramento detalhado do ciclo e da saúde.</string>
    <string name="dt_ovulation_test_name">Teste de ovulação</string>
    <string name="dt_ovulation_test_rationale">Envie os resultados dos testes de ovulação ao seu StepMonitor service para rastrear janelas de fertilidade e apoiar fluxos de planejamento familiar.</string>
    <string name="dt_cervical_mucus_name">Muco cervical</string>
    <string name="dt_cervical_mucus_rationale">Transmita as observações de muco cervical ao seu StepMonitor service para apoiar métodos de consciência da fertilidade e rastreamento das fases do ciclo.</string>
    <string name="dt_sexual_activity_name">Atividade sexual</string>
    <string name="dt_sexual_activity_rationale">Envie registros de atividade sexual ao seu StepMonitor service para correlacioná-los com dados do ciclo e obter informações sobre saúde reprodutiva.</string>
    <string name="dt_basal_body_temp_name">Temperatura basal do corpo</string>
    <string name="dt_basal_body_temp_rationale">Transmita as medições de temperatura basal matinal para detectar a ovulação, rastrear fases do ciclo e apoiar métodos de consciência da fertilidade.</string>
    <string name="dt_hc_rationale">O StepMonitor exige acesso a seus dados de aptidão e de saúde física. Os mesmos auxiliam rigorosamente seus parâmetros transmitindo exclusivamente suas preferências aos links cadastrados perante você sob as bases das plataformas sem haver partilha não autorizada à outra via, configurados consoante tua ordem expressa do que aceita partilhar ou repassar.</string>
