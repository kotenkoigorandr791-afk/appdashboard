    <string name="onboarding_privacy_title">Vos données, votre contrôle</string>
    <string name="onboarding_privacy_subtitle">Cette application est un transféreur transparent. Voici exactement comment vos données sont traitées :</string>
    <string name="onboarding_privacy_p1">Vous décidez quels types de données de santé activer — rien n’est lu sans votre choix</string>
    <string name="onboarding_privacy_p2">Les autorisations ne sont demandées que pour les types que vous activez. Si vous n’activez jamais un type, son autorisation n’est jamais demandée</string>
    <string name="onboarding_privacy_p3">Vos données sont envoyées directement à vos propres URL StepMonitor service - nulle part ailleurs</string>
    <string name="onboarding_privacy_p4">Rien n’est stocké sur un serveur externe</string>
    <string name="onboarding_privacy_p5">Vos données ne sont jamais vendues ou partagées avec quiconque</string>
   <string name="onboarding_privacy_footer">Vous avez des commentaires ou des suggestions ? Ouvrez l\'onglet Paramètres à tout moment et appuyez sur Fournir des commentaires.</string>
    <string name="onboarding_privacy_warning_title">N\'utilisez que la version officielle</string>
    <string name="onboarding_privacy_warning_desc">Les versions piratées ou modifiées de cette application peuvent voler vos URL StepMonitor service ou envoyer vos données de santé à des serveurs inconnus. Téléchargez toujours depuis AppDashboard.</string>
    <string name="medical_disclaimer_title">Cette app n\'est pas un dispositif médical</string>
    <string name="medical_disclaimer_desc">Cette application n\'est pas un dispositif médical et n\'est pas destinée à diagnostiquer, traiter, guérir ou prévenir une maladie ou un état médical. Les données de santé affichées proviennent de Health Connect et sont uniquement à des fins d\'information personnelle. Consultez toujours un professionnel de santé qualifié pour tout conseil médical.</string>
    <string name="dt_steps_name">Pas</string>
    <string name="dt_steps_rationale">Suivez le nombre de pas quotidiens et envoyez les totaux d\’activité à votre StepMonitor service pour l\’automatisation de la condition physique.</string>
    <string name="dt_sleep_name">Sommeil</string>
    <string name="dt_sleep_rationale">Transmettez la durée des sessions de sommeil et les phases (léger, profond, paradoxal) pour créer des rapports de sommeil personnalisés.</string>
    <string name="dt_hr_name">Fréquence cardiaque</string>
    <string name="dt_hr_rationale">Suivez vos relevés de fréquence cardiaque vers votre StepMonitor service en temps réel pour surveillance de la santé ou l\’analyse des entraînements.</string>
    <string name="dt_hrv_name">Variabilité de fréquence cardiaque</string>
    <string name="dt_hrv_rationale">Envoyez les relevés de VFC (RMSSD) à votre StepMonitor service pour suivre le niveau de stress, la récupération et la santé du système nerveux.</string>
    <string name="dt_dist_name">Distance</string>
    <string name="dt_dist_rationale">Transmettez la distance quotidienne parcourue pour consigner la course, la marche ou le vélo.</string>
    <string name="dt_act_cal_name">Calories actives</string>
    <string name="dt_act_cal_rationale">Envoyez les données de combustion des calories actives pour l\’entraînement, la nutrition ou des objectifs sportifs.</string>
    <string name="dt_tot_cal_name">Calories totales</string>
    <string name="dt_tot_cal_rationale">Transmettez la dépense calorique quotidienne totale pour des suivis du bilan énergétique et des flux de gestion de régime.</string>
    <string name="dt_weight_name">Poids</string>
    <string name="dt_weight_rationale">Synchronisez les mesures de poids corporel à votre StepMonitor service pour suivre les tendances, définir votre IMC ou les objectifs.</string>
    <string name="dt_height_name">Taille</string>
    <string name="dt_height_rationale">Envoyez les données de taille à votre StepMonitor service pour permettre le calcul de la composition corporelle et de l\’IMC.</string>
    <string name="dt_bp_name">Tension artérielle</string>
    <string name="dt_bp_rationale">Transmettez les relevés systolique et diastolique pour surveiller la santé cardiovasculaire et envoyer des alertes.</string>
    <string name="dt_bg_name">Glycémie</string>
    <string name="dt_bg_rationale">Envoyez vos niveaux de glucose dans le sang à votre StepMonitor service pour aider à la gestion du diabète, du régime, etc.</string>
    <string name="dt_oxy_name">Saturation en oxygène</string>
    <string name="dt_oxy_rationale">Transmettez les taux de SpO₂ pour surveiller votre santé respiratoire et identifier les éventuels épisodes de faible oxygène.</string>
    <string name="dt_temp_name">Température corporelle</string>
    <string name="dt_temp_rationale">Envoyez les relevés de température à votre StepMonitor service pour la détection de maladies, la surveillance de la fièvre, etc.</string>
    <string name="dt_skin_temp_name">Température cutanée</string>
    <string name="dt_skin_temp_rationale">Transmettez les écarts de température cutanée des bracelets à votre StepMonitor service pour le bien-être et le suivi du sommeil.</string>
    <string name="dt_resp_name">Fréquence respiratoire</string>
    <string name="dt_resp_rationale">Transmettez les données du rythme respiratoire pour suivre la santé et surveiller la récupération via votre StepMonitor service.</string>
    <string name="dt_rhr_name">Fréquence cardiaque au repos</string>
    <string name="dt_rhr_rationale">Envoyez votre fréquence cardiaque au repos quotidienne vers votre StepMonitor service pour suivre la condition cardiovasculaire et l\’amélioration sportive.</string>
    <string name="dt_exer_name">Séances d\’exercice</string>
    <string name="dt_exer_rationale">Transmettez les séances d\’entraînement comprenant le type d\’exercice et la durée vers votre StepMonitor service pour analyse et suivi.</string>
    <string name="dt_hydr_name">Hydratation</string>
    <string name="dt_hydr_rationale">Envoyez l\’absorption de fluides à votre StepMonitor service pour prendre en charge le suivi quotidien de votre hydratation et rappels.</string>
    <string name="dt_nutr_name">Nutrition</string>
    <string name="dt_nutr_rationale">Transmettez les données sur les calories et macronutriments (protéines, glucides, lipides) pour les régimes.</string>
    <string name="dt_bmr_name">Métabolisme de base</string>
    <string name="dt_bmr_rationale">Envoyez vos données BMR (TMB) à votre StepMonitor service pour permettre de personnaliser les cibles de calories et suivre votre métabolisme.</string>
    <string name="dt_bf_name">Graisse corporelle</string>
    <string name="dt_bf_rationale">Transmettez vos relevés sur le pourcentage de masse grasse pour surveiller les évolutions de composition physique et corpulence.</string>
    <string name="dt_lbm_name">Masse corporelle maigre</string>
    <string name="dt_lbm_rationale">Envoyez la teneur en masse maigre à votre StepMonitor service afin de surveiller la prise et la perte musculaires.</string>
    <string name="dt_bwm_name">Masse d\'eau corporelle</string>
    <string name="dt_bwm_rationale">Transmettez les mesures de masse d\'eau corporelle à votre StepMonitor service pour suivre l\'hydratation et la composition corporelle.</string>
    <string name="dt_vo2_name">VO₂ Max</string>
    <string name="dt_vo2_rationale">Transmetsez les données de VO₂ max à votre StepMonitor service pour suivre l\’endurance et surveiller les progrès et améliorations de condition.</string>
    <string name="dt_bone_name">Masse osseuse</string>
    <string name="dt_bone_rationale">Envoyez vos mesures de densité osseuse à votre StepMonitor service pour prendre en charge la santé de votre squelette.</string>
    <string name="dt_menstruation_flow_name">Flux menstruel</string>
    <string name="dt_menstruation_flow_rationale">Transmettez les données d\'intensité du flux menstruel à votre StepMonitor service pour suivre les schémas du cycle, les symptômes et les tendances sur la durée.</string>
    <string name="dt_menstruation_period_name">Période menstruelle</string>
    <string name="dt_menstruation_period_rationale">Envoyez les dates de début et de fin des règles à votre StepMonitor service pour consigner la durée du cycle et automatiser les flux de santé reproductive.</string>
    <string name="dt_intermenstrual_bleeding_name">Saignement intermenstruel</string>
    <string name="dt_intermenstrual_bleeding_rationale">Transmettez les événements de spotting ou de saignements entre les règles à votre StepMonitor service pour un suivi détaillé du cycle et de la santé.</string>
    <string name="dt_ovulation_test_name">Test d\'ovulation</string>
    <string name="dt_ovulation_test_rationale">Envoyez les résultats des tests d\'ovulation à votre StepMonitor service pour suivre les fenêtres de fertilité et soutenir les flux de planification familiale.</string>
    <string name="dt_cervical_mucus_name">Glaire cervicale</string>
    <string name="dt_cervical_mucus_rationale">Transmettez vos observations sur la glaire cervicale à votre StepMonitor service pour soutenir les méthodes de conscience de la fertilité et le suivi des phases du cycle.</string>
    <string name="dt_sexual_activity_name">Activité sexuelle</string>
    <string name="dt_sexual_activity_rationale">Envoyez les enregistrements d\'activité sexuelle à votre StepMonitor service pour les corréler aux données du cycle et obtenir des informations sur la santé reproductive.</string>
    <string name="dt_basal_body_temp_name">Température basale</string>
    <string name="dt_basal_body_temp_rationale">Transmettez les mesures de température basale matinales pour détecter l\'ovulation, suivre les phases du cycle et soutenir la conscience de la fertilité.</string>
    <string name="dt_hc_rationale">StepMonitor nécessite un accès à vos données de santé et d\’activité physique. Ces données sont utilisées strictement pour la fonctionnalité de base de l\’application : transmettre en toute sécurité les mesures de santé choisies directement à vos URL personnelles. Nous ne vendons ou ne partageons pas vos données. Seules les données choisies et configurées par vos soins seront demandées.</string>
