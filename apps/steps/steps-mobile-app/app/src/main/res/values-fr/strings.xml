    <string name="onboarding_welcome_title">Health Connect vers StepMonitor service</string>
    <string name="onboarding_welcome_subtitle">Transférez automatiquement vos données de santé vers n’importe quel StepMonitor service.</string>
    <string name="onboarding_thank_you">Merci pour votre soutien !</string>
    <string name="onboarding_thank_you_title">Vous êtes prêt !</string>
    <string name="onboarding_thank_you_desc">Configurez vos data sync et lancez la synchronisation. Si quelque chose ne marche pas ou si vous voulez une nouvelle fonction, ouvrez Paramètres → Fournir des commentaires.</string>
    
    <string name="onboarding_feature1_title">Vous choisissez quoi synchroniser</string>
    <string name="onboarding_feature1_desc">Sélectionnez uniquement les types de données de santé que vous souhaitez transférer.</string>
    <string name="onboarding_feature2_title">Envoyer à n’importe quelle URL StepMonitor service</string>
    <string name="onboarding_feature2_desc">Vos données vont directement aux URL configurées — nulle part ailleurs.</string>
    <string name="onboarding_feature3_title">Autorisations à la demande</string>
    <string name="onboarding_feature3_desc">Les autorisations Health Connect ne sont demandées que pour les types que vous activez.</string>

    <string name="onboarding_datatypes_title">Types de données disponibles</string>
    <string name="onboarding_datatypes_desc">Choisissez parmi %1$d types de données de santé à transférer vers votre StepMonitor service. Vous avez le contrôle - seul ce que vous activez est synchronisé.</string>
