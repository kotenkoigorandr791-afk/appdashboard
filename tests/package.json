{
  "name": "appdashboard-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test -c config/playwright.config.ts",
    "test:headed": "playwright test -c config/playwright.config.ts --headed",
    "test:ui": "playwright test -c config/playwright.config.ts --ui",
    "test:report": "playwright show-report test-results/html-report",
    "install:browsers": "playwright install chromium firefox webkit"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^26.3.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "1.62.1"
  }
}
